# ======================
# Aliases Section
# ======================
[aliases]
# Vim-style aliases
q = quit
qa = quit
w = next
wq = next
x = next

# Navigation aliases
first = goto 1
last = goto -1

# ======================
# Vim-like Keybindings
# ======================
[binds]
# Basic navigation (vim-style)
h = prev
l = next
j = pan 0 50
k = pan 0 -50
<Shift+h> = pan -50 0
<Shift+l> = pan 50 0  
<Shift+j> = pan 0 50
<Shift+k> = pan 0 -50

# Go to first/last image
g = goto 1
<Shift+g> = goto -1

# Zooming
plus = zoom 1
minus = zoom -1
equal = reset
<Shift+w> = scaling full
<Shift+e> = scaling full
i = zoom 1
o = zoom -1

# Image manipulation  
r = rotate by 90
<Shift+r> = rotate by -90
f = flip horizontal
<Shift+f> = flip vertical

# View modes
<Ctrl+f> = fullscreen
<Ctrl+v> = overlay
v = overlay
space = overlay

# File operations - using aliases
colon = command
<Shift+semicolon> = command

# Slideshow controls
s = slideshow +1
<Ctrl+s> = slideshow 0

# Window management
<Ctrl+w> = close
<Ctrl+n> = exec imv &
q = quit
<Shift+z><Shift+z> = quit

# Additional vim-like bindings
n = next
<Shift+n> = prev
p = prev

# Advanced navigation
<Ctrl+d> = pan 0 200
<Ctrl+u> = pan 0 -200
<Home> = center
<End> = center
<Page_Up> = prev
<Page_Down> = next

# Mouse bindings
<ScrollUp> = zoom 1
<ScrollDown> = zoom -1

# Function keys
<F11> = fullscreen
<F1> = overlay

# Number keys for quick selection (vim-style)
1 = goto 1
2 = goto 2
3 = goto 3
4 = goto 4
5 = goto 5
6 = goto 6
7 = goto 7
8 = goto 8
9 = goto 9
0 = goto -1
