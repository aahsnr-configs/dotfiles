# ======================
# imv's defaults overlap with several custom bindings below.
[options]
suppress_default_binds = true

# ======================
# Aliases Section
# ======================
[aliases]
# Vim-style aliases
q = quit
qa = quit
w = next
wq = next
x = next

# Navigation aliases
first = goto 1
last = goto -1

# ======================
# Vim-like Keybindings
# ======================
[binds]
# Basic navigation (vim-style)
h = prev
l = next
j = pan 0 50
k = pan 0 -50
<Shift+H> = pan -50 0
<Shift+L> = pan 50 0
<Shift+J> = pan 0 50
<Shift+K> = pan 0 -50

# Go to first/last image
g = goto 1
<Shift+G> = goto -1

# Zooming
<plus> = zoom 1
<minus> = zoom -1
<Equals> = reset
<Shift+W> = scaling full
<Shift+E> = scaling full
i = zoom 1
o = zoom -1

# Image manipulation  
r = rotate by 90
<Shift+R> = rotate by -90
f = flip horizontal
<Shift+F> = flip vertical

# View modes
<Ctrl+f> = fullscreen
<Ctrl+v> = overlay
v = overlay
<Space> = overlay

# File operations - using aliases
<colon> = command

# Slideshow controls
t = slideshow +1
<Shift+T> = slideshow -1

# Window management
<Ctrl+w> = close
q = quit
<Shift+Z><Shift+Z> = quit

# Additional vim-like bindings
n = next
<Shift+N> = prev
p = prev

# Advanced navigation
<Ctrl+d> = pan 0 200
<Ctrl+u> = pan 0 -200
<Home> = center
<End> = center
<PageUp> = prev
<PageDown> = next

# Function keys
<F11> = fullscreen
<F1> = overlay

# Number keys for quick selection (vim-style)
1 = goto 1
2 = goto 2
3 = goto 3
4 = goto 4
5 = goto 5
6 = goto 6
7 = goto 7
8 = goto 8
9 = goto 9
0 = goto -1
