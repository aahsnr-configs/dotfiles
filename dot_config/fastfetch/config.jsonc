{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/art.txt",
        "padding": {
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#7aa2f7",
            "output": "#c0caf5",
            "separator": "#414868"
        }
    },
    "modules": [
        {
            "type": "title",
            "keyColor": "#bb9af7",
            "outputColor": "#bb9af7"
        },
        {
            "type": "custom",
            "format": "{##414868}────────────────────────"
        },
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        {
            "type": "custom",
            "format": "{##7aa2f7}●  {##7dcfff}●  {##9ece6a}●  {##e0af68}●  {##f7768e}●  {##bb9af7}●  {##414868}●"
        }
    ]
}
