# =============================================================================
# GPG AGENT CONFIG (uses gpgconf --launch for a safe start)
# =============================================================================

setup_gpg_agent() {
    print_section "Configuring GPG Agent"

    mkdir -p "${GNUPG_DIR}"
    chmod 700 "${GNUPG_DIR}"

    # pinentry-curses (and gpg itself) need to know the controlling terminal
    if tty -s 2>/dev/null; then
        GPG_TTY="$(tty)"
        export GPG_TTY
    fi

    local agent_conf="${GNUPG_DIR}/gpg-agent.conf"
    local gpg_conf="${GNUPG_DIR}/gpg.conf"

    # Never overwrite existing GPG config without a backup
    backup_item "${agent_conf}" || true

    # Determine the best available pinentry
    local pinentry_prog=""
    pinentry_prog="$(pinentry_program 2>/dev/null || true)"

    cat >"${agent_conf}" <<EOF
# gpg-agent.conf - Generated by ${SCRIPT_NAME} v${SCRIPT_VERSION}
default-cache-ttl 28800
max-cache-ttl 86400
EOF

    if [[ -n "${pinentry_prog}" ]]; then
        echo "pinentry-program ${pinentry_prog}" >>"${agent_conf}"
        print_success "GPG agent will use pinentry: ${pinentry_prog}"
    else
        print_warning "No pinentry program found. Passphrase prompts may fail."
        print_info "Install one (e.g. the 'pinentry' package) and re-run if key generation fails."
    fi

    chmod 600 "${agent_conf}"

    # gpg.conf (only created if absent, so user settings are never clobbered)
    if [[ ! -f "${gpg_conf}" ]]; then
        cat >"${gpg_conf}" <<EOF
# gpg.conf - Generated by ${SCRIPT_NAME}
keyid-format long
with-fingerprint
trust-model direct
EOF
        chmod 600 "${gpg_conf}"
        print_success "GPG config written: ${gpg_conf}"
    fi

    # Restart the agent safely via gpgconf so the new config is picked up
    gpgconf --kill gpg-agent 2>/dev/null || true
    if gpgconf --launch gpg-agent 2>/dev/null; then
        print_success "GPG agent (re)started"
        gpg-connect-agent updatestartuptty /bye &>/dev/null || true
    else
        print_warning "Could not launch GPG agent (it may already be running or managed by systemd)"
    fi
}

# =============================================================================
# GPG KEY GENERATION (Ed25519 + Cv25519, passphrase set interactively)
# =============================================================================

generate_gpg_keys() {
    print_section "Generating GPG Keys (Ed25519 + Cv25519) for Commit Signing"

    print_info "One GPG key will be created per GitHub account."
    print_info "These keys are used to sign commits and tags - visible on GitHub as 'Verified'."
    print_info "You will be asked to set a passphrase for each key interactively."
    print_warning "Please use a strong, memorable passphrase. Do not leave it empty!"
    echo ""

    local generated=0
    local account email name fp fingerprint batch_input gen_log

    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        name="${GIT_NAMES[${account}]}"

        if gpg_key_exists "${email}"; then
            fp="$(gpg_account_fingerprint "${account}")"
            print_info "GPG key already exists for ${account} (${email})"
            print_info "  Fingerprint: ${fp}"
            continue
        fi

        print_info "Generating GPG key for ${account} (${name} <${email}>)..."
        print_info "Pinentry will prompt for a passphrase. If none appears, use Ctrl+C to abort."

        batch_input="$(mktemp)"
        gen_log="$(mktemp)"
        TEMP_FILES+=("${batch_input}" "${gen_log}")

        cat >"${batch_input}" <<EOF
Key-Type: eddsa
Key-Curve: Ed25519
Key-Usage: sign,cert
Subkey-Type: ecdh
Subkey-Curve: Curve25519
Subkey-Usage: encrypt
Name-Real: ${name}
Name-Email: ${email}
Expire-Date: 2y
%commit
EOF

        if gpg --batch --gen-key "${batch_input}" 2>"${gen_log}"; then
            fingerprint="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${fingerprint}" ]]; then
                # Mark our own key as ultimately trusted
                echo "${fingerprint}:6:" | gpg --import-ownertrust 2>/dev/null || true
                print_success "Generated GPG key for ${account}: ${fingerprint}"
                generated=$((generated + 1))
            else
                print_warning "Generated key for ${account} but could not retrieve its fingerprint"
            fi
        else
            print_error "Failed to generate GPG key for ${account}"
            sed 's/^/    gpg: /' "${gen_log}" >&2 || true
        fi

        rm -f "${batch_input}" "${gen_log}"
    done

    local -a missing=()
    for account in "${ACCOUNT_ORDER[@]}"; do
        gpg_key_exists "${ACCOUNTS[${account}]}" || missing+=("${account}")
    done

    if [[ ${generated} -gt 0 ]]; then
        print_success "Generated ${generated} new GPG key(s)"
    elif [[ ${#missing[@]} -eq 0 ]]; then
        print_info "All GPG keys already exist"
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "GPG keys are still missing for: ${missing[*]}"
        print_info "Commits and tags for those accounts cannot be signed until this is fixed."
        print_info "Review the 'gpg:' output above; pinentry or passphrase problems are the usual cause."
    fi
}

# =============================================================================
# GPG KEY BACKUP (managed secret keys only - for offline secure storage)
# =============================================================================

backup_gpg_keys() {
    print_section "Backing Up GPG Keys"

    mkdir -p "${GPG_BACKUP_DIR}"
    chmod 700 "${GPG_BACKUP_DIR}"

    local stamp
    stamp="$(date +%Y%m%d)"
    local backup_file="${GPG_BACKUP_DIR}/managed-secret-keys-${stamp}.asc"
    local trust_file="${GPG_BACKUP_DIR}/ownertrust-${stamp}.txt"

    # Only export the keys this script manages
    local account fp
    local -a fingerprints=()
    for account in "${ACCOUNT_ORDER[@]}"; do
        if gpg_key_exists "${ACCOUNTS[${account}]}"; then
            fp="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${fp}" ]]; then
                fingerprints+=("${fp}")
            fi
        fi
    done

    if [[ ${#fingerprints[@]} -eq 0 ]]; then
        print_warning "No managed GPG secret keys found; nothing to back up"
        return 0
    fi

    print_info "Exporting ${#fingerprints[@]} secret key(s); you may be asked for each key's passphrase."

    # umask 077 so the secret-key file is never world-readable, even briefly
    if (
        umask 077
        gpg --yes --export-secret-keys --armor --output "${backup_file}" "${fingerprints[@]}"
    ); then
        chmod 600 "${backup_file}"
        print_success "Secret keys backed up: ${backup_file}"
    else
        print_warning "Could not export secret keys"
    fi

    if (
        umask 077
        gpg --export-ownertrust >"${trust_file}"
    ) 2>/dev/null; then
        chmod 600 "${trust_file}"
        print_success "Owner trust backed up: ${trust_file}"
    fi

    print_warning "Store ${GPG_BACKUP_DIR} on encrypted offline storage (e.g., LUKS USB)!"
    print_info "Without these backups you cannot restore commit-signing capability on a new machine."
}

# =============================================================================
# VERIFICATION
# =============================================================================

verify_setup() {
    print_section "Verifying Setup"

    local all_good=true
    local account email key_file pub_file fp alias_key alias_expected_key

    # Check SSH keys
    print_info "Checking SSH keys..."
    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"
        pub_file="${key_file}.pub"

        if [[ -f "${key_file}" && -f "${pub_file}" ]]; then
            echo -e "  ${GREEN}✓${NC} ${account}: SSH keys exist"
        else
            echo -e "  ${RED}✗${NC} ${account}: SSH keys missing"
            all_good=false
        fi
    done

    # Check GPG keys
    print_info "Checking GPG keys..."
    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            fp="$(gpg_account_fingerprint "${account}")"
            echo -e "  ${GREEN}✓${NC} ${account}: GPG key exists (${fp:0:16}...)"
        else
            echo -e "  ${RED}✗${NC} ${account}: GPG key missing (commits will be unsigned)"
            all_good=false
        fi
    done

    # Check SSH config
    print_info "Checking SSH config..."
    if [[ -f "${SSH_DIR}/config" ]]; then
        if ssh -F "${SSH_DIR}/config" -G "${SSH_HOST_PREFIX}configs" &>/dev/null; then
            print_success "SSH config exists and is valid"
        else
            print_error "SSH config has syntax errors"
            all_good=false
        fi
    else
        print_error "SSH config missing"
        all_good=false
    fi

    # Every account's host alias must resolve to its own key
    for account in "${ACCOUNT_ORDER[@]}"; do
        alias_expected_key="$(ssh_key_file "${account}")"
        alias_key="$(ssh -F "${SSH_DIR}/config" -G "${SSH_HOST_PREFIX}${account}" 2>/dev/null |
            awk 'tolower($1) == "identityfile" { print $2; exit }' || true)"
        if [[ "${alias_key}" == "${alias_expected_key}" ]]; then
            echo -e "  ${GREEN}✓${NC} ${account}: SSH alias uses its own key"
        else
            echo -e "  ${RED}✗${NC} ${account}: SSH alias uses ${alias_key:-<none>}"
            all_good=false
        fi
    done

    # Check Git config
    print_info "Checking Git config..."
    if [[ -f "${GIT_CONFIG}" ]]; then
        if git config --global --list &>/dev/null; then
            print_success "Main Git config exists and is valid"
        else
            print_error "Main Git config has syntax errors"
            all_good=false
        fi
    else
        print_error "Main Git config missing"
        all_good=false
    fi

    # Check directory-specific configs
    local dir dir_config
    for account in "${DIR_ACCOUNTS[@]}"; do
        dir="${GIT_DIRS[${account}]}"
        dir_config="${dir}/.gitconfig"
        if [[ -f "${dir_config}" ]]; then
            echo -e "  ${GREEN}✓${NC} ${GIT_NAMES[${account}]} Git config exists (${dir})"
        else
            echo -e "  ${RED}✗${NC} ${GIT_NAMES[${account}]} Git config missing (${dir})"
            all_good=false
        fi
    done

    # Test Git conditional includes with a throw-away repo in each directory
    print_info "Testing Git conditional includes..."
    local test_dir detected_email detected_key expected_key
    for account in "${DIR_ACCOUNTS[@]}"; do
        dir="${GIT_DIRS[${account}]}"

        if [[ ! -d "${dir}" ]]; then
            print_warning "${dir} doesn't exist; skipping conditional include test"
            continue
        fi

        test_dir="$(mktemp -d "${dir}/.git_test_XXXXXX" 2>/dev/null || true)"
        if [[ -z "${test_dir}" ]]; then
            print_warning "Could not create test directory in ${dir}"
            continue
        fi
        TEMP_DIRS+=("${test_dir}")

        if git -C "${test_dir}" init &>/dev/null; then
            detected_email="$(git -C "${test_dir}" config user.email 2>/dev/null || true)"

            if [[ "${detected_email}" == "${ACCOUNTS[${account}]}" ]]; then
                echo -e "  ${GREEN}✓${NC} ${dir} correctly configured (${detected_email})"
            else
                echo -e "  ${RED}✗${NC} ${dir} not properly configured"
                echo -e "     Expected: ${ACCOUNTS[${account}]}, Got: ${detected_email:-<empty>}"
                all_good=false
            fi

            if gpg_key_exists "${ACCOUNTS[${account}]}"; then
                expected_key="$(gpg_account_fingerprint "${account}")"
                detected_key="$(git -C "${test_dir}" config user.signingkey 2>/dev/null || true)"
                if [[ "${detected_key}" == "${expected_key}" ]]; then
                    echo -e "  ${GREEN}✓${NC} ${dir} uses its own GPG signing key"
                else
                    echo -e "  ${RED}✗${NC} ${dir} has the wrong signing key"
                    all_good=false
                fi
            fi
        else
            print_warning "Could not init test repo in ${test_dir}"
        fi
        rm -rf -- "${test_dir}"
    done

    echo ""
    if [[ "${all_good}" == "true" ]]; then
        print_success "All checks passed! ✨"
    else
        print_warning "Some checks failed. Please review the output above."
        return 1
    fi
}

