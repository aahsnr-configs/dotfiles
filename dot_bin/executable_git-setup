    done

    say "${BOLD}5. Directory Structure and Auto-Switching${NC}\n\n"
    say "   ${GIT_BASE_DIR}/\n"
    local branch i=0
    for account in "${DIR_ACCOUNTS[@]}"; do
        i=$((i + 1))
        if [[ ${i} -eq ${#DIR_ACCOUNTS[@]} ]]; then branch="└──"; else branch="├──"; fi
