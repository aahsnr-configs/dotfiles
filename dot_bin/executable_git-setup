    say "   After cloning and making a commit:\n"
    say "   ${CYAN}git log --show-signature -1${NC}\n"
    say "   You should see: \"gpg: Good signature from ...\"\n\n"
    say "   On GitHub, commits will show a green 'Verified' badge.\n\n"

    say "${BOLD}8. GPG Key Backups and Expiry${NC}\n\n"
    say "   GPG secret key backups: ${CYAN}${GPG_BACKUP_DIR}/managed.*/${NC}\n"
    say "   Store this directory on encrypted offline storage (USB/LUKS).\n"
    say "   Without it you cannot restore commit-signing on a new machine.\n\n"
    say "   To transfer to a new machine:\n"
    say "   Import managed-secret-keys.asc and ownertrust.txt from one matching managed.* directory.\n\n"
    say "   The generated GPG keys expire after 2 years. To extend one:\n"
    say "   ${CYAN}gpg --quick-set-expire <FINGERPRINT> 2y${NC}        # primary key\n"
    say "   ${CYAN}gpg --quick-set-expire <FINGERPRINT> 2y '*'${NC}    # all subkeys\n"
    say "   then re-export the public key and update it on GitHub.\n\n"

    say "${BOLD}Backup Information:${NC}\n\n"
    say "   All previous configurations were backed up to:\n"
    say "   ${CYAN}${BACKUP_DIR}${NC}\n\n"

    say "${BOLD}Pro Tips:${NC}\n\n"
    say "   • Always clone repos into the correct directory for auto identity switching\n"
    say "   • Inside each ~/Git/<account>/ directory, plain git@github.com: URLs\n"
    say "     automatically use that account's SSH key (url.insteadOf)\n"
    say "   • Use ${CYAN}git config user.email${NC} inside a repo to confirm the active identity\n"
    say "   • If a repo is in the wrong directory, fix the remote URL:\n"
    say "     ${CYAN}git remote set-url origin git@${SSH_HOST_PREFIX}<account>:USER/REPO.git${NC}\n"
    say "   • Ed25519 GPG and SSH keys are more secure and faster than RSA\n"
    say "\n"

    print_success "Setup complete! Happy coding! 🚀"
}

# =============================================================================
# MAIN FUNCTION
# =============================================================================

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [-h|--help] [-V|--version]

Resets and rebuilds the multi-account GitHub SSH, GPG and Git configuration.
Everything it removes is backed up first, and a confirmation is required
before anything is deleted. Run it from an interactive terminal as a normal
(non-root) user.
EOF
}

main() {
    if (($# > 0)); then
        case "$1" in
        -h | --help)
            usage
            return 0
            ;;
        -V | --version)
            echo "${SCRIPT_NAME} ${SCRIPT_VERSION}"
            return 0
            ;;
        *)
            print_error "Unknown argument: $1"
            usage >&2
            return 2
            ;;
        esac
    fi

    print_header

    validate_account_config

    check_dependencies

    echo ""
    print_info "This script will CLEAN UP SSH keys and files, Git config, GitHub CLI"
    print_info "logins, and GPG keys you own (all backed up first), then set up fresh"
    print_info "SSH keys, GPG keys (for commit signing), Git config, and GitHub CLI"
    print_info "for multiple GitHub accounts."
    echo ""

    # Cleanup (scoped, confirmed, backed up)
    cleanup_all_configs

    # GPG must come before configure_git so signing keys can be embedded
    setup_gpg_agent
    generate_gpg_keys

    # Generate SSH keys and configure SSH
    generate_ssh_keys
    configure_ssh

    # Configure Git (identity, signing key, and SSH auth for every account)
    configure_git

    # Back up managed GPG secret keys
    backup_gpg_keys

    # Load SSH keys (only if an agent is running)
    setup_ssh_agent

    # Configure GitHub CLI
    configure_github_cli

    # Verify everything
    if verify_setup; then
        display_public_keys
        display_instructions
    else
        print_error "Setup verification failed. Please check the errors above."
        exit 1
    fi
}

# =============================================================================
# SCRIPT ENTRY POINT
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
