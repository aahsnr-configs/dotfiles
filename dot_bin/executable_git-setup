# =============================================================================
# GPG AGENT CONFIG (uses gpgconf --launch for a safe start)
# =============================================================================

setup_gpg_agent() {
    print_section "Configuring GPG Agent"

    mkdir -p "${GNUPG_DIR}"
    chmod 700 "${GNUPG_DIR}"

    # pinentry-curses (and gpg itself) need to know the controlling terminal
    if tty -s 2>/dev/null; then
        GPG_TTY="$(tty)"
        export GPG_TTY
    fi

    local agent_conf="${GNUPG_DIR}/gpg-agent.conf"
    local agent_temp

    # Determine the best available pinentry
    local pinentry_prog=""
    pinentry_prog="$(pinentry_program 2>/dev/null || true)"

    agent_temp="$(mktemp "${GNUPG_DIR}/gpg-agent.XXXXXX")"
    TEMP_FILES+=("${agent_temp}")
    cat >"${agent_temp}" <<EOF
# gpg-agent.conf - Generated by ${SCRIPT_NAME} v${SCRIPT_VERSION}
default-cache-ttl 28800
max-cache-ttl 86400
EOF

    if [[ -n "${pinentry_prog}" ]]; then
        echo "pinentry-program ${pinentry_prog}" >>"${agent_temp}"
        print_success "GPG agent will use pinentry: ${pinentry_prog}"
    else
        print_warning "No pinentry program found. Passphrase prompts may fail."
        print_info "Install one (e.g. the 'pinentry' package) and re-run if key generation fails."
    fi

    chmod 600 "${agent_temp}"
    mv -- "${agent_temp}" "${agent_conf}"

    # Restart the agent safely via gpgconf so the new config is picked up
    gpgconf --kill gpg-agent 2>/dev/null || true
    if gpgconf --launch gpg-agent 2>/dev/null; then
        print_success "GPG agent (re)started"
        gpg-connect-agent updatestartuptty /bye &>/dev/null || true
    else
        print_warning "Could not launch GPG agent (it may already be running or managed by systemd)"
    fi
}

# =============================================================================
# GPG KEY GENERATION (Ed25519 + Cv25519, passphrase set interactively)
# =============================================================================

generate_gpg_keys() {
    print_section "Generating GPG Keys (Ed25519 + Cv25519) for Commit Signing"

    print_info "One GPG key will be created per GitHub account."
    print_info "These keys are used to sign commits and tags - visible on GitHub as 'Verified'."
    print_info "You will be asked to set a passphrase for each key interactively."
    print_warning "Please use a strong, memorable passphrase. Do not leave it empty!"
    echo ""

    local generated=0
    local account email name fingerprint batch_input gen_log

    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        name="${GIT_NAMES[${account}]}"

        if gpg_key_exists "${email}"; then
            fingerprint="$(gpg_account_fingerprint "${account}")"
            if [[ -z "${fingerprint}" ]]; then
                print_error "Existing GPG key for ${account} does not match its configured identity"
                return 1
            fi
            print_info "GPG key already exists for ${account} (${email})"
            print_info "  Fingerprint: ${fingerprint}"
            continue
        fi

        print_info "Generating GPG key for ${account} (${name} <${email}>)..."
        print_info "Pinentry will prompt for a passphrase. If none appears, use Ctrl+C to abort."

        batch_input="$(mktemp "${TMPDIR:-/tmp}/git-setup-gpg.XXXXXX")"
        gen_log="$(mktemp "${TMPDIR:-/tmp}/git-setup-gpg-log.XXXXXX")"
        TEMP_FILES+=("${batch_input}" "${gen_log}")

        cat >"${batch_input}" <<EOF
Key-Type: eddsa
Key-Curve: Ed25519
Key-Usage: sign,cert
Subkey-Type: ecdh
Subkey-Curve: Curve25519
Subkey-Usage: encrypt
Name-Real: ${name}
Name-Email: ${email}
Expire-Date: 2y
%commit
EOF

        if gpg --batch --gen-key "${batch_input}" 2>"${gen_log}"; then
            fingerprint="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${fingerprint}" ]]; then
                # Mark our own key as ultimately trusted
                if ! echo "${fingerprint}:6:" | gpg --import-ownertrust 2>/dev/null; then
                    print_error "Could not set ownertrust for ${account}"
                    return 1
                fi
                print_success "Generated GPG key for ${account}: ${fingerprint}"
                generated=$((generated + 1))
            else
                print_error "Generated key for ${account} but could not retrieve its fingerprint"
                return 1
            fi
        else
            print_error "Failed to generate GPG key for ${account}"
            sed 's/^/    gpg: /' "${gen_log}" >&2 || true
            return 1
        fi

        rm -f "${batch_input}" "${gen_log}"
    done

    local -a missing=()
    for account in "${ACCOUNT_ORDER[@]}"; do
        gpg_key_exists "${ACCOUNTS[${account}]}" || missing+=("${account}")
    done

    if [[ ${generated} -gt 0 ]]; then
        print_success "Generated ${generated} new GPG key(s)"
    elif [[ ${#missing[@]} -eq 0 ]]; then
        print_info "All GPG keys already exist"
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "GPG keys are still missing for: ${missing[*]}"
        print_info "Commits and tags for those accounts cannot be signed until this is fixed."
        print_info "Review the 'gpg:' output above; pinentry or passphrase problems are the usual cause."
        return 1
    fi
}

# =============================================================================
# GPG KEY BACKUP (managed secret keys only - for offline secure storage)
# =============================================================================

backup_gpg_keys() {
    print_section "Backing Up GPG Keys"

    mkdir -p -- "${GPG_BACKUP_DIR}"
    chmod 700 -- "${GPG_BACKUP_DIR}"

    # Only export the keys this script manages
    local account fp backup_dir backup_file trust_file
    local -a fingerprints=()
    for account in "${ACCOUNT_ORDER[@]}"; do
        if gpg_key_exists "${ACCOUNTS[${account}]}"; then
            fp="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${fp}" ]]; then
                fingerprints+=("${fp}")
            fi
        fi
    done

    if [[ ${#fingerprints[@]} -eq 0 ]]; then
        print_error "No managed GPG secret keys found; cannot create the required backup"
        return 1
    fi

    print_info "Exporting ${#fingerprints[@]} secret key(s); you may be asked for each key's passphrase."
    backup_dir="$(mktemp -d "${GPG_BACKUP_DIR}/managed.XXXXXXXXXX")"
    chmod 700 -- "${backup_dir}"
    backup_file="${backup_dir}/managed-secret-keys.asc"
    trust_file="${backup_dir}/ownertrust.txt"

    if ! gpg --yes --export-secret-keys --armor --output "${backup_file}" "${fingerprints[@]}" || [[ ! -s "${backup_file}" ]]; then
        print_error "Could not export the managed GPG secret keys"
        return 1
    fi
    chmod 600 -- "${backup_file}"

    if ! gpg --export-ownertrust >"${trust_file}"; then
        print_error "Could not export GPG ownertrust"
        return 1
    fi
    chmod 600 -- "${trust_file}"

    print_success "Secret keys backed up: ${backup_file}"
    print_success "Owner trust backed up: ${trust_file}"
    print_warning "Store ${GPG_BACKUP_DIR} on encrypted offline storage (e.g., LUKS USB)!"
    print_info "Without these backups you cannot restore commit-signing capability on a new machine."
}

# =============================================================================
# VERIFICATION
# =============================================================================

verify_setup() {
    print_section "Verifying Setup"

    local all_good=true
    local account email key_file fp alias_key alias_expected_key

    # Check SSH keys
    print_info "Checking SSH keys..."
    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"

        if validate_ssh_key_pair "${key_file}"; then
            printf '%b\n' "  ${GREEN}✓${NC} ${account}: SSH keys exist"
        else
            printf '%b\n' "  ${RED}✗${NC} ${account}: SSH key pair is missing, invalid, or mismatched"
            all_good=false
        fi
    done

    # Check GPG keys
    print_info "Checking GPG keys..."
    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            fp="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${fp}" ]]; then
                printf '%b\n' "  ${GREEN}✓${NC} ${account}: GPG key exists (${fp:0:16}...)"
            else
                printf '%b\n' "  ${RED}✗${NC} ${account}: GPG key has no matching account fingerprint"
                all_good=false
            fi
        else
            printf '%b\n' "  ${RED}✗${NC} ${account}: GPG key missing (commits will be unsigned)"
            all_good=false
        fi
    done

    # Check SSH config
    print_info "Checking SSH config..."
    if [[ -f "${SSH_DIR}/config" ]]; then
        if ssh -F "${SSH_DIR}/config" -G "${SSH_HOST_PREFIX}configs" &>/dev/null; then
            print_success "SSH config exists and is valid"
        else
            print_error "SSH config has syntax errors"
            all_good=false
        fi
    else
        print_error "SSH config missing"
        all_good=false
    fi

    # Every account's host alias must resolve to its own key
    for account in "${ACCOUNT_ORDER[@]}"; do
        alias_expected_key="$(ssh_key_file "${account}")"
        alias_key="$(ssh -F "${SSH_DIR}/config" -G "${SSH_HOST_PREFIX}${account}" 2>/dev/null |
            awk 'tolower($1) == "identityfile" { sub(/^[^[:space:]]+[[:space:]]+/, ""); print; exit }' || true)"
        if [[ "${alias_key}" == "${alias_expected_key}" ]]; then
            printf '%b\n' "  ${GREEN}✓${NC} ${account}: SSH alias uses its own key"
        else
            printf '%b\n' "  ${RED}✗${NC} ${account}: SSH alias uses ${alias_key:-<none>}"
            all_good=false
        fi
    done

    # Check Git config
    print_info "Checking Git config..."
    if [[ -f "${GIT_CONFIG}" ]]; then
        if git config --file "${GIT_CONFIG}" --list &>/dev/null; then
            print_success "Main Git config exists and is valid"
        else
            print_error "Main Git config has syntax errors"
            all_good=false
        fi
    else
        print_error "Main Git config missing"
        all_good=false
    fi

    # Inspect generated files directly; do not create repositories or other
    # temporary files inside the account directories.
    print_info "Checking per-directory Git configs..."
    local dir dir_config real_dir expected_key detected_name detected_email detected_key include_path
    for account in "${DIR_ACCOUNTS[@]}"; do
        dir="${GIT_DIRS[${account}]}"
        dir_config="${dir}/.gitconfig"
        if [[ ! -f "${dir_config}" ]]; then
            printf '%b\n' "  ${RED}✗${NC} ${GIT_NAMES[${account}]} Git config missing (${dir})"
            all_good=false
            continue
        fi
        if ! git config --file "${dir_config}" --list &>/dev/null; then
            print_error "${dir_config} has invalid Git config syntax"
            all_good=false
            continue
        fi

        detected_name="$(git config --file "${dir_config}" --get user.name 2>/dev/null || true)"
        detected_email="$(git config --file "${dir_config}" --get user.email 2>/dev/null || true)"
        detected_key="$(git config --file "${dir_config}" --get user.signingkey 2>/dev/null || true)"
        expected_key="$(gpg_account_fingerprint "${account}")"
        if [[ "${detected_name}" == "${GIT_NAMES[${account}]}" &&
            "${detected_email}" == "${ACCOUNTS[${account}]}" &&
            -n "${expected_key}" && "${detected_key}" == "${expected_key}" ]]; then
            printf '%b\n' "  ${GREEN}✓${NC} ${dir_config} has the expected identity and signing key"
        else
            printf '%b\n' "  ${RED}✗${NC} ${dir_config} does not match ${account}"
            all_good=false
        fi

        real_dir="$(cd -- "${dir}" && pwd -P)"
        include_path="$(git config --file "${GIT_CONFIG}" --get "includeIf.gitdir:${real_dir}/.path" 2>/dev/null || true)"
        if [[ "${include_path}" == "${real_dir}/.gitconfig" ]]; then
            printf '%b\n' "  ${GREEN}✓${NC} ${GIT_CONFIG} includes ${dir_config}"
        else
            printf '%b\n' "  ${RED}✗${NC} ${GIT_CONFIG} has no matching include for ${dir}"
            all_good=false
        fi
    done

    echo ""
    if [[ "${all_good}" == "true" ]]; then
        print_success "All checks passed! ✨"
    else
        print_warning "Some checks failed. Please review the output above."
        return 1
    fi
}

# =============================================================================
# DISPLAY PUBLIC KEYS
# =============================================================================

display_public_keys() {
    print_section "Public Keys for GitHub"

    echo "Copy these public keys to your respective GitHub accounts:"
    echo ""
    echo "GitHub Settings → SSH and GPG keys → New SSH key"
    echo ""

    local account email pub_file pubkey fingerprint gpg_fp
    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        pub_file="$(ssh_key_file "${account}").pub"

        if [[ -f "${pub_file}" ]]; then
            printf '%b\n' "${BOLD}${CYAN}╭─ Account: ${GIT_NAMES[${account}]} (${email})${NC}"
            printf '%b\n' "${YELLOW}│${NC}"

            pubkey="$(cat "${pub_file}")"
            printf '%b %s\n' "${YELLOW}│${NC}" "${pubkey}"

            fingerprint="$(ssh-keygen -lf "${pub_file}" 2>/dev/null | awk '{print $2}' || true)"
            printf '%b\n' "${YELLOW}│${NC}"
            printf '%b %s\n' "${YELLOW}│${NC}" "SSH Fingerprint: ${fingerprint}"

            if gpg_key_exists "${email}"; then
                gpg_fp="$(gpg_account_fingerprint "${account}")"
                printf '%b %s\n' "${YELLOW}│${NC}" "GPG Fingerprint: ${gpg_fp}"
            fi

            printf '%b\n' "${YELLOW}╰───────────────────────────────────────────────────────────────${NC}"
            echo ""
        fi
    done

    echo ""
    echo "For GPG keys (GitHub Settings → SSH and GPG keys → New GPG key):"
    echo ""
    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            gpg_fp="$(gpg_account_fingerprint "${account}")"
            if [[ -n "${gpg_fp}" ]]; then
                printf '%b\n' "${BOLD}${CYAN}GPG public key for ${account} (${email}):${NC}"
                # Export by fingerprint so only this account's key is printed
                gpg --armor --export "${gpg_fp}" 2>/dev/null
                echo ""
            fi
        fi
    done
}

