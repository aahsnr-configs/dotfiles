# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

print_error() { printf '%b\n' "${RED}✗ Error: $*${NC}" >&2; }
print_success() { printf '%b\n' "${GREEN}✓ $*${NC}"; }
print_warning() { printf '%b\n' "${YELLOW}⚠ Warning: $*${NC}"; }
print_info() { printf '%b\n' "${BLUE}→ $*${NC}"; }
print_section() {
    echo ""
    printf '%b\n' "${BOLD}${BLUE}═══ $* ═══${NC}"
    echo ""
}

print_header() {
    local width=68 bar
    printf -v bar '%*s' "${width}" ''
    bar="${bar// /═}"
    printf '%b\n' "${BOLD}${CYAN}"
    printf '╔%s╗\n' "${bar}"
    printf '║%-*s║\n' "${width}" "   Multi-Account GitHub Setup Script v${SCRIPT_VERSION}"
    printf '║%-*s║\n' "${width}" "   SSH (Ed25519) + GPG Commit Signing + GitHub CLI"
    printf '╚%s╝\n' "${bar}"
    printf '%b' "${NC}"
}

# Like printf '%b' but takes a single string (so text is never a format string)
say() { printf '%b' "$1"; }

# confirm PROMPT [Y|N]  -- second argument is the default answer (default: N)
confirm() {
    local prompt="$1" default="${2:-N}" hint response
    if [[ "${default}" == [Yy] ]]; then hint="Y/n"; else hint="y/N"; fi
    while true; do
        if ! read -r -p "$(printf '%b' "${YELLOW}${prompt} [${hint}]: ${NC}")" response; then
            echo ""
            return 1 # EOF on stdin counts as "no"
        fi
        case "${response}" in
        [Yy] | [Yy][Ee][Ss]) return 0 ;;
        [Nn] | [Nn][Oo]) return 1 ;;
        "")
            if [[ "${default}" == [Yy] ]]; then return 0; else return 1; fi
            ;;
        *) echo "Please answer yes or no." ;;
        esac
    done
}

command_exists() { command -v "$1" &>/dev/null; }

ssh_key_file() { echo "${SSH_DIR}/${SSH_KEY_PREFIX}$1"; }

validate_ssh_key_pair() {
    local private_key="$1" private_fp public_fp
    [[ -f "${private_key}" && ! -L "${private_key}" && -f "${private_key}.pub" && ! -L "${private_key}.pub" ]] || return 1
    private_fp="$(ssh-keygen -lf "${private_key}" 2>/dev/null | awk 'NR == 1 { print $2 }')" || return 1
    public_fp="$(ssh-keygen -lf "${private_key}.pub" 2>/dev/null | awk 'NR == 1 { print $2 }')" || return 1
    [[ -n "${private_fp}" && "${private_fp}" == "${public_fp}" ]]
}

# Fail early when the account maps drift apart (e.g. an account added to
# ACCOUNTS but not GIT_NAMES), instead of aborting mid-run under set -u
# Fail early when the account maps drift apart (e.g. an account added to
# ACCOUNTS but not GIT_NAMES), or when a value could not be written safely into
# the GPG batch file or the Git/SSH config files that are generated from it.
validate_account_config() {
    local account email name dir
    local -A seen_emails=() seen_dirs=()
    local name_re='^[A-Za-z0-9._ -]+$'
    local email_re='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$'

    for account in "${ACCOUNT_ORDER[@]}"; do
        if [[ ! "${account}" =~ ^[a-z0-9_-]+$ ]]; then
            print_error "Account name '${account}' may only contain a-z, 0-9, '_' and '-'"
            return 1
        fi
        email="${ACCOUNTS[${account}]:-}"
        name="${GIT_NAMES[${account}]:-}"
        if [[ -z "${email}" ]]; then
            print_error "Account '${account}' is missing from ACCOUNTS"
            return 1
        fi
        if [[ -z "${name}" ]]; then
            print_error "Account '${account}' is missing from GIT_NAMES"
            return 1
        fi
        if [[ ! "${email}" =~ ${email_re} ]]; then
            print_error "Invalid e-mail address for '${account}': ${email}"
            return 1
        fi
        if [[ ! "${name}" =~ ${name_re} ]]; then
            print_error "Invalid Git name for '${account}': '${name}' (allowed: letters, digits, space . _ -)"
            return 1
        fi
        if [[ -n "${seen_emails[${email}]:-}" ]]; then
            print_error "Duplicate e-mail '${email}' (account '${account}')"
            return 1
        fi
        seen_emails["${email}"]=1
    done

    for account in "${DIR_ACCOUNTS[@]}"; do
        if [[ " ${ACCOUNT_ORDER[*]} " != *" ${account} "* ]]; then
            print_error "Directory account '${account}' is not in ACCOUNT_ORDER"
            return 1
        fi
        if [[ -z "${GIT_DIRS[${account}]:-}" ]]; then
            print_error "Directory account '${account}' is missing from GIT_DIRS"
            return 1
        fi
        dir="${GIT_DIRS[${account}]}"
        if [[ "${dir}" == *[\"\\]* || "${dir}" == *$'\n'* ]]; then
            print_error "Git directory for '${account}' contains a quote, backslash or newline: ${dir}"
            return 1
        fi
        if [[ ! -d "${dir}" ]]; then
            print_error "Managed Git directory does not exist: ${dir}"
            return 1
        fi
        if [[ -n "${seen_dirs[${dir}]:-}" ]]; then
            print_error "Duplicate Git directory '${dir}' (account '${account}')"
            return 1
        fi
        seen_dirs["${dir}"]=1
    done

    return 0
}

# Create the backup directory, private to the current user (it will hold
# private keys and tokens)
create_backup_dir() {
    mkdir -p -- "${BACKUP_ROOT}"
    BACKUP_DIR="$(mktemp -d "${BACKUP_ROOT}/github_setup.XXXXXXXXXX")"
    chmod 700 -- "${BACKUP_DIR}"
}

# Back up a file or directory into BACKUP_DIR, preserving its path relative to
# $HOME so that files with the same name (e.g. several .gitconfig files) never
# overwrite each other.
backup_item() {
    local item="$1"
    if [[ ! -e "${item}" && ! -L "${item}" ]]; then
        return 0
    fi

    [[ -n "${BACKUP_DIR}" ]] || {
        print_error "Backup directory has not been created"
        return 1
    }

    local rel dest parent base physical_home
    parent="$(cd -- "$(dirname -- "${item}")" && pwd -P)" || return 1
    base="${item##*/}"
    physical_home="$(cd -- "${HOME}" && pwd -P)" || return 1
    if [[ "${parent}" == "${physical_home}" ]]; then
        rel="${base}"
    elif [[ "${parent}" == "${physical_home}/"* ]]; then
        rel="${parent#"${physical_home}"/}/${base}"
    else
        rel="_absolute${parent}/${base}"
    fi
    dest="${BACKUP_DIR}/${rel}"

    mkdir -p -- "$(dirname -- "${dest}")"
    if cp -a -- "${item}" "${dest}" && [[ -e "${dest}" || -L "${dest}" ]]; then
        print_success "Backed up ${item} → ${dest}"
        return 0
    fi
    print_error "Failed to back up ${item}"
    return 1
}

# =============================================================================
# ERROR HANDLING AND CLEANUP
# =============================================================================

cleanup() {
    local exit_code=$?
    local item
    if [[ ${#TEMP_FILES[@]} -gt 0 ]]; then
        for item in "${TEMP_FILES[@]}"; do
            rm -f -- "${item}" 2>/dev/null || true
        done
    fi
    if [[ ${exit_code} -ne 0 ]]; then
        print_error "Script exited with error code ${exit_code}"
    fi
    exit "${exit_code}"
}

error_handler() {
    local line_number="$1"
    local exit_code="$2"
    local failed_command="$3"
    print_error "Error on line ${line_number}: '${failed_command}' failed with exit code ${exit_code}"
}

on_signal() {
    echo ""
    print_warning "Interrupted by signal"
    exit "$1"
}

trap cleanup EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP
trap 'error_handler "${LINENO}" "$?" "${BASH_COMMAND}"' ERR

# =============================================================================
# COMPREHENSIVE CLEANUP (full SSH, Git, GPG, and GitHub CLI reset)
# =============================================================================

collect_cleanup_targets() {
    local entry keep account preserved
    local -a entries=()
    DELETE_TARGETS=()
    BACKUP_TARGETS=()

    if [[ -d "${SSH_DIR}" ]]; then
        # find (rather than a dotglob pattern) keeps the shell's globbing
        # options untouched and handles unusual file names safely
        mapfile -d '' -t entries < <(find -H "${SSH_DIR}" -mindepth 1 -maxdepth 1 -print0)
        for entry in "${entries[@]}"; do
            preserved=false
            for keep in "${SSH_PRESERVE[@]}"; do
                if [[ "${entry##*/}" == "${keep}" ]]; then
                    preserved=true
                    break
                fi
            done
            if [[ "${preserved}" == false ]]; then
                DELETE_TARGETS+=("${entry}")
            fi
        done
    fi

    DELETE_TARGETS+=("${GIT_CONFIG}" "${GIT_XDG_CONFIG}" "${GH_CONFIG_DIR}")
    for account in "${DIR_ACCOUNTS[@]}"; do
        DELETE_TARGETS+=("${GIT_DIRS[${account}]}/.gitconfig")
    done

    BACKUP_TARGETS=("${DELETE_TARGETS[@]}" "${GNUPG_DIR}/gpg-agent.conf")
}

# Stage all GPG recovery data before deleting any key.
backup_gpg_keyring() {
    local listing gpg_backup fpr dest
    local secret_count
    local -a fingerprints=()

    if tty -s 2>/dev/null; then
        GPG_TTY="$(tty)"
        export GPG_TTY
    fi

    if ! listing="$(gpg --list-secret-keys --with-colons --fingerprint 2>/dev/null)"; then
        print_error "Could not list GPG secret keys; refusing cleanup"
        return 1
    fi

    mapfile -t fingerprints < <(
        awk -F: '$1 == "sec" { primary = 1; next }
                 $1 == "ssb" { primary = 0; next }
                 $1 == "fpr" && primary { print $10; primary = 0 }' <<<"${listing}"
    )
    secret_count="$(awk -F: '$1 == "sec" { count++ } END { print count + 0 }' <<<"${listing}")"
    if [[ "${secret_count}" -ne ${#fingerprints[@]} ]]; then
        print_error "Could not parse every GPG secret-key fingerprint; refusing cleanup"
        return 1
    fi
    GPG_FINGERPRINTS=()
    if [[ ${#fingerprints[@]} -gt 0 ]]; then
        GPG_FINGERPRINTS=("${fingerprints[@]}")
    fi

    gpg_backup="${BACKUP_DIR}/gpg"
    mkdir -p -- "${gpg_backup}"
    chmod 700 -- "${gpg_backup}"

    if ! gpg --export-ownertrust >"${gpg_backup}/ownertrust.txt"; then
        print_error "Could not back up GPG ownertrust; refusing cleanup"
        return 1
    fi
    chmod 600 -- "${gpg_backup}/ownertrust.txt"

    if [[ ${#GPG_FINGERPRINTS[@]} -gt 0 ]]; then
        for fpr in "${GPG_FINGERPRINTS[@]}"; do
            dest="${gpg_backup}/secret-key-${fpr}.asc"
            if ! gpg --yes --armor --output "${dest}" --export-secret-keys "${fpr}" || [[ ! -s "${dest}" ]]; then
                print_error "Could not back up GPG secret key ${fpr}; refusing cleanup"
                return 1
            fi
            chmod 600 -- "${dest}"
        done
    fi
    return 0
}

delete_gpg_keyring() {
    local fpr secret_listing public_listing
    if [[ ${#GPG_FINGERPRINTS[@]} -eq 0 ]]; then
        return 0
    fi
    for fpr in "${GPG_FINGERPRINTS[@]}"; do
        if ! gpg --batch --yes --delete-secret-and-public-keys "${fpr}"; then
            print_error "Could not remove GPG key ${fpr}; recovery data is in ${BACKUP_DIR}/gpg"
            return 1
        fi
    done

    if ! secret_listing="$(gpg --list-secret-keys --with-colons --fingerprint 2>/dev/null)"; then
        print_error "Could not verify GPG secret-key deletion"
        return 1
    fi
    if ! public_listing="$(gpg --list-keys --with-colons --fingerprint 2>/dev/null)"; then
        print_error "Could not verify GPG public-key deletion"
        return 1
    fi

    for fpr in "${GPG_FINGERPRINTS[@]}"; do
        if awk -F: -v wanted="${fpr}" '$1 == "fpr" && $10 == wanted { found = 1 } END { exit !found }' <<<"${secret_listing}"; then
            print_error "GPG secret key ${fpr} remains in the keyring after deletion"
            return 1
        fi
        if awk -F: -v wanted="${fpr}" '$1 == "fpr" && $10 == wanted { found = 1 } END { exit !found }' <<<"${public_listing}"; then
            print_error "GPG public key ${fpr} remains in the keyring after deletion"
            return 1
        fi
        ITEMS_REMOVED=$((ITEMS_REMOVED + 1))
        print_success "Backed up and removed GPG key ${fpr}"
    done
}

cleanup_all_configs() {
    print_section "Configuration Cleanup"
    collect_cleanup_targets

    print_warning "${BOLD}This will DELETE the following configurations:${NC}"
    echo ""
    echo "  1. Every entry under ${SSH_DIR}, except: ${SSH_PRESERVE[*]}"
    echo "       (kept so remote logins and host verification keep working)"
    echo "  2. Global Git config:            ${GIT_CONFIG}"
    echo "  3. XDG Git config directory:     ${GIT_XDG_CONFIG} (whole directory)"
    echo "  4. Directory Git configs:        <dir>/.gitconfig for each of:"
    local account
    for account in "${DIR_ACCOUNTS[@]}"; do
        echo "       ${GIT_DIRS[${account}]}"
    done
    echo "       Only each listed .gitconfig is managed; all other folder contents remain untouched."
    echo "  5. GitHub CLI config:            ${GH_CONFIG_DIR} (removes ALL gh logins)"
    echo "  6. GPG keys:                     every secret key you own"
    echo "  7. GPG agent config:             ${GNUPG_DIR}/gpg-agent.conf (backed up, then replaced)"
    echo "  8. SSH agent:                    all identities loaded in the active agent"
    echo ""
    printf '%b\n' "${CYAN}Backups will be stored in a new private directory under ${BACKUP_ROOT}.${NC}"
    printf '%b\n' "${YELLOW}The reset aborts before deletion if any required backup fails.${NC}"
    echo ""

    if ! confirm "Do you want to proceed with the cleanup?"; then
        print_info "Cleanup cancelled. Exiting."
        exit 0
    fi

    echo ""
    create_backup_dir
    print_success "Backup directory created: ${BACKUP_DIR}"
    echo ""

    ITEMS_REMOVED=0

    local target
    for target in "${BACKUP_TARGETS[@]}"; do
        if ! backup_item "${target}"; then
            print_error "Cleanup aborted; nothing has been deleted. Partial backups: ${BACKUP_DIR}"
            return 1
        fi
    done
    if ! backup_gpg_keyring; then
        print_error "Cleanup aborted; no targets have been deleted. Backups: ${BACKUP_DIR}"
        return 1
    fi

    for target in "${DELETE_TARGETS[@]}"; do
        if [[ -e "${target}" || -L "${target}" ]]; then
            rm -rf -- "${target}"
            ITEMS_REMOVED=$((ITEMS_REMOVED + 1))
            print_success "Removed: ${target}"
        fi
    done

    if ssh-add -D &>/dev/null; then
        print_success "Cleared identities held by the active SSH agent"
    else
        print_info "No active SSH agent identities to clear"
    fi
    delete_gpg_keyring || return 1

    echo ""
    if [[ ${ITEMS_REMOVED} -gt 0 ]]; then
        print_success "Cleanup complete! ${ITEMS_REMOVED} item(s) removed."
    else
        print_info "No existing configurations found to remove."
    fi
    print_info "Backups saved to: ${BACKUP_DIR}"
    print_warning "The backup contains private keys and tokens; delete it once you no longer need it."

    echo ""
    print_info "Starting fresh configuration setup..."
}

# =============================================================================
# DEPENDENCY CHECKING
# =============================================================================

check_dependencies() {
    print_section "Checking Dependencies"
    # Prompts (confirmations, ssh-keygen and GPG passphrases) need a terminal
    if [[ ! -t 0 ]]; then
        print_error "stdin is not a terminal; run this script interactively"
        return 1
    fi
    if [[ ${EUID} -eq 0 ]]; then
        print_error "Run this user-configuration script as a non-root user"
        return 1
    fi
    if [[ ! -d "${HOME}" || "${HOME}" == "/" ]]; then
        print_error "HOME must name a non-root user's home directory"
        return 1
    fi
    if [[ "${GIT_CONFIG_GLOBAL_WAS_SET}" == x && "${GIT_CONFIG_GLOBAL:-}" != "${GIT_CONFIG}" ]]; then
        print_error "GIT_CONFIG_GLOBAL points to a non-managed path (${GIT_CONFIG_GLOBAL:-<empty>})"
        print_info "Unset GIT_CONFIG_GLOBAL or point it to ${GIT_CONFIG} before running this reset script."
        return 1
    fi
    if [[ "${XDG_CONFIG_HOME_WAS_SET}" == x && "${XDG_CONFIG_HOME_OVERRIDE}" != "${XDG_CONFIG_HOME}" ]]; then
        print_error "XDG_CONFIG_HOME points to a non-managed path (${XDG_CONFIG_HOME_OVERRIDE})"
        print_info "Unset XDG_CONFIG_HOME or point it to ${XDG_CONFIG_HOME} before running this reset script."
        return 1
    fi
    if [[ "${GH_CONFIG_DIR_WAS_SET}" == x && "${GH_CONFIG_DIR_OVERRIDE}" != "${GH_CONFIG_DIR}" ]]; then
        print_error "GH_CONFIG_DIR points to a non-managed path (${GH_CONFIG_DIR_OVERRIDE})"
        print_info "Unset GH_CONFIG_DIR or point it to ${GH_CONFIG_DIR} before running this reset script."
        return 1
    fi
    if [[ "${GNUPGHOME_WAS_SET}" == x && "${GNUPGHOME:-}" != "${GNUPG_DIR}" ]]; then
        print_error "GNUPGHOME points to a non-managed keyring (${GNUPGHOME:-<empty>})"
        print_info "Unset GNUPGHOME or point it to ${GNUPG_DIR} before running this reset script."
        return 1
    fi
    local -a required=(git ssh ssh-add ssh-keygen gpg gpgconf gpg-connect-agent awk grep sed find mktemp cp chmod mkdir mv rm date dirname cat tty)
    local -a missing=()
    local cmd git_version git_major git_minor min_major min_minor

    for cmd in "${required[@]}"; do
        command_exists "${cmd}" || missing+=("${cmd}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        print_error "Missing required commands: ${missing[*]}"
        print_info "Install these with your distribution's package manager, then rerun. No packages were installed."
        return 1
    fi

    git_version="$(git --version)"
    if [[ ! "${git_version}" =~ ([0-9]+)\.([0-9]+) ]]; then
        print_error "Could not determine the Git version"
        return 1
    fi
    git_major="${BASH_REMATCH[1]}"
    git_minor="${BASH_REMATCH[2]}"
    min_major="${MIN_GIT_VERSION%%.*}"
    min_minor="${MIN_GIT_VERSION#*.}"
    if ((10#${git_major} < 10#${min_major} || (10#${git_major} == 10#${min_major} && 10#${git_minor} < 10#${min_minor}))); then
        print_error "Git ${git_major}.${git_minor} is too old; ${MIN_GIT_VERSION} or newer is required"
        return 1
    fi
    print_success "${git_version} meets the minimum (${MIN_GIT_VERSION})"

    if command_exists gh; then
        print_success "GitHub CLI (gh) found"
    else
        print_warning "GitHub CLI (gh) not found (optional but recommended)"
        print_info "Install from: https://cli.github.com/"
    fi

    if pinentry_program &>/dev/null; then
        print_success "pinentry found (needed for GPG passphrase prompts)"
    else
        print_error "No pinentry program found; GPG passphrases cannot be prompted for"
        print_info "Install a pinentry implementation with your distribution's package manager and rerun."
        return 1
    fi

    print_success "All required dependencies satisfied"
}

# =============================================================================
# SSH KEY MANAGEMENT
# =============================================================================

generate_ssh_keys() {
    print_section "Generating SSH Keys (Ed25519)"

    mkdir -p "${SSH_DIR}"
    chmod 700 "${SSH_DIR}"

    print_info "Using Ed25519 algorithm (modern, secure, fast)"
    echo ""

    local account key_file
    local -a pending=()
    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"
        if [[ -e "${key_file}" || -L "${key_file}" || -e "${key_file}.pub" || -L "${key_file}.pub" ]]; then
            if validate_ssh_key_pair "${key_file}"; then
                print_info "Verified existing SSH key pair for ${account}"
            else
                print_error "Existing SSH key pair for ${account} is incomplete or mismatched; refusing to overwrite it"
                return 1
            fi
        else
            pending+=("${account}")
        fi
    done

    if [[ ${#pending[@]} -eq 0 ]]; then
        print_info "All SSH keys already exist"
        return 0
    fi

    # Passphrase protection is the default; declining stores unencrypted keys.
    local -a passphrase_args=(-N "")
    if confirm "Protect the new SSH keys with a passphrase? (recommended)" Y; then
        passphrase_args=()
        print_info "ssh-keygen will prompt for a passphrase for each key."
    else
        print_warning "SSH private keys will be stored unencrypted."
    fi
    echo ""

    local email generated=0
    for account in "${pending[@]}"; do
        email="${ACCOUNTS[${account}]}"
        key_file="$(ssh_key_file "${account}")"

        print_info "Generating Ed25519 key for ${account} (${email})..."

        if ssh-keygen -t ed25519 -a 100 -C "${email}" -f "${key_file}" "${passphrase_args[@]}" -q; then
            chmod 600 "${key_file}"
            chmod 644 "${key_file}.pub"

            if validate_ssh_key_pair "${key_file}"; then
                print_success "Generated key for ${account}"
                generated=$((generated + 1))
            else
                print_error "Key generation appeared to succeed but verification failed"
                return 1
            fi
        else
            print_error "Failed to generate key for ${account}"
            return 1
        fi
    done

    print_success "Generated ${generated} new SSH key(s)"
}

# =============================================================================
# SSH CONFIG MANAGEMENT
# =============================================================================

configure_ssh() {
    print_section "Configuring SSH"

    local ssh_config="${SSH_DIR}/config"
    local temp_config account key_file
    temp_config="$(mktemp "${SSH_DIR}/.config.XXXXXX")"
    TEMP_FILES+=("${temp_config}")

    {
        cat <<EOF
# =============================================================================
# Multi-Account GitHub SSH Configuration
# Generated by ${SCRIPT_NAME} v${SCRIPT_VERSION}
# =============================================================================

# Default settings for all hosts
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

EOF
        for account in "${ACCOUNT_ORDER[@]}"; do
            key_file="$(ssh_key_file "${account}")"
            cat <<EOF
# GitHub Account: ${account} (${ACCOUNTS[${account}]})
Host ${SSH_HOST_PREFIX}${account}
    HostName github.com
    User git
    IdentityFile "${key_file}"
    PreferredAuthentications publickey

EOF
        done
    } >"${temp_config}"

    # No "Host github.com" block: OpenSSH re-parses this file for the resolved
    # HostName, and because IdentityFile accumulates across that pass, such a
    # block would append the configs key to every account alias. An unregistered
    # key would then silently fall back to the configs identity instead of
    # failing. Plain git@github.com: URLs are routed to the right alias by the
    # per-directory url.insteadOf rules written in configure_git.

    if mv -- "${temp_config}" "${ssh_config}"; then
        chmod 600 "${ssh_config}"
        print_success "SSH config created: ${ssh_config}"
    else
        print_error "Failed to create SSH config"
        return 1
    fi
}

# =============================================================================
# GPG TOOLS
# =============================================================================

# Match on the exact e-mail address ("<addr>") so similar addresses can't collide
gpg_key_exists() {
    local email="$1"
    gpg --list-secret-keys --with-colons "<${email}>" &>/dev/null
}

# Prints the primary fingerprint of the first secret key for an e-mail. When
# $2 is non-empty, only a key whose UID matches that string exactly is used.
_gpg_primary_fpr() {
    local email="$1" want="${2:-}"
    gpg --list-secret-keys --with-colons --fingerprint "<${email}>" 2>/dev/null |
        awk -F: -v want="${want}" '
            $1 == "sec" { have_primary = 0; primary = ""; next }
            $1 == "fpr" && !have_primary { primary = $10; have_primary = 1; next }
            $1 == "uid" && primary != "" && (want == "" || $10 == want) {
                print primary
                exit
            }
        ' || true
}

# Fingerprint of the account's own key. Binding to "Name <email>" keeps
# accounts with more than one secret key on the same e-mail unambiguous (e.g.
# a project key in addition to the commit-signing key).
gpg_account_fingerprint() {
    local account="$1"
    local name="${GIT_NAMES[${account}]:-}"
    local email="${ACCOUNTS[${account}]:-}"
    local want="${name} <${email}>"
    local fp

    fp="$(_gpg_primary_fpr "${email}" "${want}")"
    if [[ -z "${fp}" ]]; then
        print_error "No secret GPG key has the expected UID '${want}'"
    fi
    printf '%s\n' "${fp}"
}

# Prints the path of the first available pinentry program, if any
pinentry_program() {
    local candidate
    for candidate in pinentry-curses pinentry-tty pinentry-qt pinentry-gnome3 pinentry-gtk-2 pinentry; do
        if command_exists "${candidate}"; then
            command -v "${candidate}"
            return 0
        fi
    done
    return 1
}

# =============================================================================
# GIT CONFIG MANAGEMENT (with GPG commit signing per account)
# =============================================================================

configure_git() {
    print_section "Configuring Git"

    local temp_config account dir real_dir
    local -A real_dirs=()

    for account in "${DIR_ACCOUNTS[@]}"; do
        dir="${GIT_DIRS[${account}]}"
        if [[ ! -d "${dir}" ]]; then
            print_error "Git account directory does not exist: ${dir}"
            return 1
        fi
        # Git matches gitdir includes against physical paths, not /home symlinks.
        real_dirs["${account}"]="$(cd -- "${dir}" && pwd -P)"
    done

    local configs_signing_key
    configs_signing_key="$(gpg_account_fingerprint configs)"
    if [[ -z "${configs_signing_key}" ]]; then
        print_error "No usable GPG signing key for the configs account"
        return 1
    fi

    temp_config="$(mktemp "${GIT_CONFIG}.XXXXXX")"
    TEMP_FILES+=("${temp_config}")

    {
        cat <<EOF
# =============================================================================
# Multi-Account Git Configuration
# Generated by ${SCRIPT_NAME} v${SCRIPT_VERSION}
# =============================================================================

[user]
    name = ${GIT_NAMES[configs]}
    email = ${ACCOUNTS[configs]}
    signingkey = ${configs_signing_key}

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    colorMoved = zebra

[merge]
    conflictstyle = diff3

[rerere]
    enabled = true

[gpg]
    program = gpg

[commit]
    gpgsign = true

[tag]
    gpgsign = true

EOF
        for account in "${DIR_ACCOUNTS[@]}"; do
            real_dir="${real_dirs[${account}]}"
            cat <<EOF
[includeIf "gitdir:${real_dir}/"]
    path = "${real_dir}/.gitconfig"

EOF
        done
    } >"${temp_config}"

    if mv -- "${temp_config}" "${GIT_CONFIG}"; then
        chmod 644 "${GIT_CONFIG}"
        print_success "Main Git config created: ${GIT_CONFIG}"
    else
        print_error "Failed to create main Git config"
        return 1
    fi

    # Write per-directory gitconfigs with account-specific signing keys
    local dir_config account_signing_key temp_dir_config
    for account in "${DIR_ACCOUNTS[@]}"; do
        real_dir="${real_dirs[${account}]}"
        dir_config="${real_dir}/.gitconfig"
        account_signing_key="$(gpg_account_fingerprint "${account}")"
        if [[ -z "${account_signing_key}" ]]; then
            print_error "No usable GPG signing key for ${account}"
            return 1
        fi

        # Create the temp file next to its destination so the final mv is an
        # atomic same-filesystem rename
        temp_dir_config="$(mktemp "${real_dir}/.gitconfig.XXXXXX")"
        TEMP_FILES+=("${temp_dir_config}")

        # Inside this directory, plain GitHub SSH URLs must authenticate with
        # this account's key; per-directory rewrites cannot be shadowed by a
        # global rewrite, so no global insteadOf rule is written
        cat >"${temp_dir_config}" <<EOF
# Git configuration for ${GIT_NAMES[${account}]} in ${real_dir}
# Generated by ${SCRIPT_NAME} v${SCRIPT_VERSION}
[user]
    name = ${GIT_NAMES[${account}]}
    email = ${ACCOUNTS[${account}]}
    signingkey = ${account_signing_key}

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[url "git@${SSH_HOST_PREFIX}${account}:"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
EOF

        chmod 644 "${temp_dir_config}"
        mv -- "${temp_dir_config}" "${dir_config}"
        print_success "Created ${account} Git config: ${dir_config}"
    done
}

# =============================================================================
# SSH AGENT SETUP (never starts an orphaned agent; only adds keys to a live one)
# =============================================================================

setup_ssh_agent() {
    print_section "Setting Up SSH Agent"

    # ssh-add -l exits 0 (keys loaded), 1 (agent running, no keys), 2 (no agent)
    local rc=0
    ssh-add -l &>/dev/null || rc=$?
    if [[ ${rc} -eq 2 ]]; then
        print_warning "No running SSH agent detected."
        print_info "Please start an agent manually. Examples:"
        print_info "  eval \$(ssh-agent)   # add to ~/.bashrc / ~/.profile"
        print_info "  systemctl --user enable --now ssh-agent  # on systemd systems"
        print_info "Keys will not be loaded now. Add them later with: ssh-add ~/.ssh/${SSH_KEY_PREFIX}<account>"
        return 0
    fi
    print_success "SSH agent is running"

    local added=0
    local already=0
    local account key_file pub_file key_fp loaded

    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"
        pub_file="${key_file}.pub"

        if [[ ! -f "${key_file}" || ! -f "${pub_file}" ]]; then
            print_warning "Key file not found for ${account}: ${key_file}"
            continue
        fi

        # "|| true": a bad .pub file must reach the warning below, not abort
        # the whole script via pipefail + errexit
        key_fp="$(ssh-keygen -lf "${pub_file}" 2>/dev/null | awk '{print $2}' || true)"
        if [[ -z "${key_fp}" ]]; then
            print_warning "Could not get fingerprint for ${account} key"
            continue
        fi

        loaded="$(ssh-add -l 2>/dev/null || true)"
        if grep -qF -- "${key_fp}" <<<"${loaded}"; then
            print_info "Key for ${account} already loaded"
            already=$((already + 1))
        else
            print_info "Adding key for ${account} to agent..."
            # stderr stays visible so passphrase/agent errors are not hidden
            if ssh-add "${key_file}"; then
                print_success "Added key for ${account}"
                added=$((added + 1))
            else
                print_warning "Could not add key for ${account}"
            fi
        fi
    done

    if [[ ${added} -gt 0 ]]; then
        print_success "Added ${added} key(s) to SSH agent"
    fi
    if [[ ${already} -gt 0 ]]; then
        print_info "${already} key(s) already in SSH agent"
    fi
    return 0
}

