    say "   Paste the GPG public key for each account shown above.\n"
    say "   Once added, commits signed with that key will show as 'Verified' on GitHub.\n"
    say "   Each account's commit e-mail must also be a verified e-mail on that GitHub account.\n\n"

    say "${BOLD}3. Test SSH Connections${NC}\n\n"
    local account
    for account in "${ACCOUNT_ORDER[@]}"; do
        say "   ${CYAN}ssh -T git@${SSH_HOST_PREFIX}${account}${NC}  # Test ${account}\n"
    done
    say "\n   Expected: \"Hi username! You've successfully authenticated...\"\n\n"

    say "${BOLD}4. Clone Repositories${NC}\n\n"
    say "   Use the SSH host alias matching the target account:\n\n"
    say "   ${GREEN}configs${NC} (in ~/Git/ root-level):\n"
    say "   ${CYAN}cd ~/Git && git clone git@${SSH_HOST_PREFIX}configs:aahsnr/repo.git${NC}\n\n"
    say "   ${GREEN}personal${NC} (in ~/Git/personal/):\n"
    say "   ${CYAN}cd ~/Git/personal && git clone git@${SSH_HOST_PREFIX}personal:aahsnr/repo.git${NC}\n\n"
    say "   ${GREEN}work${NC} (in ~/Git/work/ - GitHub user ${GIT_NAMES[halcyon]}):\n"
    say "   ${CYAN}cd ~/Git/work && git clone git@${SSH_HOST_PREFIX}halcyon:${GIT_NAMES[halcyon]}/repo.git${NC}\n\n"
    say "   ${GREEN}common${NC} (in ~/Git/common/):\n"
    say "   ${CYAN}cd ~/Git/common && git clone git@${SSH_HOST_PREFIX}common:aahsnr/repo.git${NC}\n\n"
    say "   ${GREEN}halcyon${NC} (in ~/Git/halcyon/ - GitHub user ${GIT_NAMES[work]}):\n"
    say "   ${CYAN}cd ~/Git/halcyon && git clone git@${SSH_HOST_PREFIX}work:${GIT_NAMES[work]}/repo.git${NC}\n\n"

    say "${BOLD}5. Directory Structure and Auto-Switching${NC}\n\n"
    say "   ${HOME}/Git/\n"
    say "   ├── personal/  ${GREEN}→ personal account + GPG key (${ACCOUNTS[personal]})${NC}\n"
    say "   ├── work/      ${GREEN}→ ${GIT_NAMES[halcyon]} account + GPG key (${ACCOUNTS[halcyon]})${NC}\n"
    say "   ├── common/    ${GREEN}→ common account + GPG key (${ACCOUNTS[common]})${NC}\n"
    say "   ├── halcyon/   ${GREEN}→ ${GIT_NAMES[work]} account + GPG key (${ACCOUNTS[work]})${NC}\n"
    say "   └── other/     ${GREEN}→ configs account + GPG key (${ACCOUNTS[configs]})${NC}\n\n"
    say "   Git automatically uses the correct identity and signing key based on\n"
    say "   which directory your repository lives in - no manual switching needed.\n\n"

    say "${BOLD}6. Tell GPG About Your Terminal (needed for passphrase prompts)${NC}\n\n"
    say "   bash/zsh (add to ~/.bashrc or ~/.zshrc):\n"
    say "   ${CYAN}export GPG_TTY=\$(tty)${NC}\n"
    say "   fish (add to ~/.config/fish/config.fish):\n"
    say "   ${CYAN}set -gx GPG_TTY (tty)${NC}\n\n"

    say "${BOLD}7. Verify Commit Signing${NC}\n\n"
    say "   After cloning and making a commit:\n"
    say "   ${CYAN}git log --show-signature -1${NC}\n"
    say "   You should see: \"gpg: Good signature from ...\"\n\n"
    say "   On GitHub, commits will show a green 'Verified' badge.\n\n"

    say "${BOLD}8. GPG Key Backups and Expiry${NC}\n\n"
    say "   GPG secret key backup: ${CYAN}${GPG_BACKUP_DIR}/${NC}\n"
    say "   Store this directory on encrypted offline storage (USB/LUKS).\n"
    say "   Without it you cannot restore commit-signing on a new machine.\n\n"
    say "   To transfer to a new machine:\n"
    say "   ${CYAN}gpg --import ${GPG_BACKUP_DIR}/managed-secret-keys-<date>.asc${NC}\n"
    say "   ${CYAN}gpg --import-ownertrust ${GPG_BACKUP_DIR}/ownertrust-<date>.txt${NC}\n\n"
    say "   The generated GPG keys expire after 2 years. To extend one:\n"
    say "   ${CYAN}gpg --quick-set-expire <FINGERPRINT> 2y${NC}        # primary key\n"
    say "   ${CYAN}gpg --quick-set-expire <FINGERPRINT> 2y '*'${NC}    # all subkeys\n"
    say "   then re-export the public key and update it on GitHub.\n\n"

    say "${BOLD}Backup Information:${NC}\n\n"
    say "   All previous configurations were backed up to:\n"
    say "   ${CYAN}${BACKUP_DIR}${NC}\n\n"

    say "${BOLD}Pro Tips:${NC}\n\n"
    say "   • Always clone repos into the correct directory for auto identity switching\n"
    say "   • Inside each ~/Git/<account>/ directory, plain git@github.com: URLs\n"
    say "     automatically use that account's SSH key (url.insteadOf)\n"
    say "   • Use ${CYAN}git config user.email${NC} inside a repo to confirm the active identity\n"
    say "   • If a repo is in the wrong directory, fix the remote URL:\n"
    say "     ${CYAN}git remote set-url origin git@${SSH_HOST_PREFIX}<account>:USER/REPO.git${NC}\n"
    say "   • Ed25519 GPG and SSH keys are more secure and faster than RSA\n"
    say "   • See the companion git-crypt guide to add transparent file encryption\n\n"

    print_success "Setup complete! Happy coding! 🚀"
}

# =============================================================================
# MAIN FUNCTION
# =============================================================================

main() {
    print_header

    validate_account_config

    check_dependencies

    echo ""
    print_info "This script will CLEAN UP SSH keys and files, Git config, GitHub CLI"
    print_info "logins, and GPG keys you own (all backed up first), then set up fresh"
    print_info "SSH keys, GPG keys (for commit signing), Git config, and GitHub CLI"
    print_info "for multiple GitHub accounts."
    echo ""
    print_info "Detected distribution: ${BOLD}${DISTRO}${NC}"
    echo ""

    # Cleanup (scoped, confirmed, backed up)
    cleanup_all_configs

    # GPG must come before configure_git so signing keys can be embedded
    setup_gpg_agent
    generate_gpg_keys

    # Generate SSH keys and configure SSH
    generate_ssh_keys
    configure_ssh

    # Configure Git (identity, signing key, and SSH auth for every account)
    configure_git

    # Back up managed GPG secret keys
    backup_gpg_keys

    # Load SSH keys (only if an agent is running)
    setup_ssh_agent

    # Configure GitHub CLI
    configure_github_cli

    # Verify everything
    if verify_setup; then
        display_public_keys
        display_instructions
    else
        print_error "Setup verification failed. Please check the errors above."
        exit 1
    fi
}

# =============================================================================
# SCRIPT ENTRY POINT
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
