#!/usr/bin/env bash
#
# Multi-Account GitHub SSH and Git Setup Script
#
# Accounts managed: configs, personal, work, common, and halcyon
# The work and halcyon identities are crossed by design: "aahsnr-work"
# <aahsnr@duck.com> serves ~/Git/halcyon, and "halcyon-linux"
# <aahsnr041@proton.me> serves ~/Git/work
#
# This script configures SSH keys (Ed25519), Git settings (with GPG commit
# signing), and GitHub CLI for multiple GitHub accounts with proper isolation
# and automatic identity switching based on directory location.
#
# Features:
# - Full cleanup of SSH keys and files, Git config, GitHub CLI logins, and
#   GPG keys you own (after an explicit confirmation)
# - Every removed item is backed up first, preserving its path, into a
#   private (chmod 700) backup directory; GPG keys are exported one by one
# - OS detection: Arch Linux (pacman) and Gentoo (emerge); offers to install
#   missing required packages
# - Generates Ed25519 SSH keys - one per account (optional passphrase)
# - Generates Ed25519/Cv25519 GPG keys - one per account (passphrase protected)
#   used exclusively for commit and tag signing
# - Configures SSH config with host aliases
# - Sets up Git with conditional includes for directory-based account switching
#   of identity, GPG signing key, and SSH auth (url.insteadOf)
# - Configures GitHub CLI for SSH protocol
# - Configures gpg-agent with sane cache TTLs and a safe launch
# - Exports backups of the managed GPG secret keys to ~/.gnupg/backups/
# - Verifies every account ends with both an SSH and a GPG key, and that each
#   account's host alias resolves to its own key
# - Comprehensive error handling and validation
# - Plain ANSI color output (respects NO_COLOR; fish shell compatible)
#
# Requirements: bash >= 4.4, git, ssh, ssh-keygen, gpg, gpgconf, gh (optional)
# Compatible with: Arch Linux, Gentoo Linux
# Shell Compatibility: bash (works when executed from fish shell)
#
# License: GPL-3.0
# Version: 5.6.0

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    echo "Error: bash >= 4.4 is required (found ${BASH_VERSION})." >&2
    exit 1
fi

# -E makes the ERR trap fire inside functions as well
set -Eeuo pipefail
shopt -s nullglob

# =============================================================================
# CONSTANTS AND CONFIGURATION
# =============================================================================

readonly SCRIPT_VERSION="5.6.0"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly SCRIPT_NAME
readonly SSH_DIR="${HOME}/.ssh"
readonly GIT_CONFIG="${HOME}/.gitconfig"
readonly GIT_XDG_CONFIG="${HOME}/.config/git"
readonly GIT_BASE_DIR="${HOME}/Git"
readonly GH_CONFIG_DIR="${HOME}/.config/gh"
BACKUP_DIR="${HOME}/.config_backups/github_setup_$(date +%Y%m%d_%H%M%S)"
readonly BACKUP_DIR
readonly GNUPG_DIR="${HOME}/.gnupg"
readonly GPG_BACKUP_DIR="${GNUPG_DIR}/backups"

# Naming scheme for managed SSH keys and host aliases
readonly SSH_KEY_PREFIX="id_ed25519_aahsnr_"
readonly SSH_HOST_PREFIX="github.com-aahsnr-"

# Detect operating system
OS_TYPE="$(uname -s)"
readonly OS_TYPE
if [[ "${OS_TYPE}" == "Darwin" ]]; then
    readonly IS_MACOS="true"
else
    readonly IS_MACOS="false"
fi

# Detect Linux distribution
detect_distro() {
    if [[ -f /etc/arch-release ]]; then
        echo "arch"
    elif [[ -f /etc/gentoo-release ]]; then
        echo "gentoo"
    elif [[ -f /etc/os-release ]]; then
        # Source in a subshell so os-release variables don't leak into the script
        local ids
        # shellcheck source=/dev/null
        ids="$(
            . /etc/os-release
            echo "${ID:-} ${ID_LIKE:-}"
        )"
        case " ${ids} " in
        *" arch "*) echo "arch" ;;
        *" gentoo "*) echo "gentoo" ;;
        *) echo "unknown" ;;
        esac
    else
        echo "unknown"
    fi
}
DISTRO="$(detect_distro)"
readonly DISTRO

# Minimum required Git version (includeIf support arrived in 2.13)
readonly MIN_GIT_VERSION="2.13"

# Color codes (only when stdout is a terminal and NO_COLOR is not set)
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED="" GREEN="" YELLOW="" BLUE="" CYAN="" BOLD="" NC=""
fi

# Account configurations - modify these for your accounts
declare -A ACCOUNTS=(
    ["configs"]="ahsanur041@proton.me"
    ["personal"]="ahsanur041@gmail.com"
    ["work"]="aahsnr@duck.com"
    ["common"]="ahsan.05rahman@gmail.com"
    ["halcyon"]="aahsnr041@proton.me"
