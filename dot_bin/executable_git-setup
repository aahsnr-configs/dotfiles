#!/usr/bin/env bash
#
# git-setup - multi-account GitHub setup with ONE SSH key per account
#
# For every account listed in ACCOUNTS below, this script:
#   1. creates (or reuses) one Ed25519 SSH key. The same key authenticates you
#      to GitHub AND signs your commits and tags ("SSH signing", Git >= 2.34).
#   2. creates ~/Git/<account>/ and a small per-account Git config.
#   3. wires it together with includeIf "gitdir:", so the identity, signing key
#      and SSH key are picked from the directory a repository lives in. Plain
#      git@github.com:OWNER/REPO.git URLs just work, even for `git clone`.
#   4. writes an allowed_signers file so `git log --show-signature` can verify
#      your own signatures locally.
#
# There is no GPG, gpg-agent, pinentry, API token or key backup to manage: the
# SSH keys are the only secrets, and each has an optional passphrase.
#
# Safe to re-run: existing keys are reused, nothing is ever deleted, and any
# file that would change is first copied to ~/.config_backups/. Files this
# script does not own (other SSH keys, ~/.ssh/config, GPG keys, gh logins,
# unrelated settings in ~/.gitconfig) are left alone.
#
# Requirements: bash >= 4.4, git >= 2.34, OpenSSH >= 8.2 (gh is optional)
# Usage:        git-setup [-h|--help] [-V|--version]
# License:      GPL-3.0

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
    echo "Error: bash >= 4.4 is required (found ${BASH_VERSION})." >&2
    exit 1
fi

set -Eeuo pipefail
umask 077
: "${HOME:?HOME must be set}"

# =============================================================================
# CONFIGURATION - edit this section for your accounts
# =============================================================================

# One line per account: "name|Git user name|e-mail"
#   name    -> repositories live in ~/Git/<name>/, key is ~/.ssh/id_ed25519_aahsnr_<name>
#   e-mail  -> must be a verified e-mail on that GitHub account, otherwise
#              commits are signed but GitHub does not show "Verified"
#   The FIRST account is also the global default identity (used outside ~/Git/*).
readonly -a ACCOUNTS=(
    "configs|aahsnr-configs|ahsanur041@proton.me"
    "personal|aahsnr-personal|ahsanur041@gmail.com"
    "work|aahsnr-work|aahsnr@duck.com"
    "common|aahsnr-common|ahsan.05rahman@gmail.com"
    "halcyon|halcyon-linux|aahsnr041@proton.me"
)

# General Git preferences. Each is applied ONLY if you have not set it already.
readonly -a GIT_DEFAULTS=(
    "init.defaultBranch=main"
    "pull.rebase=false"
    "push.default=current"
    "push.autoSetupRemote=true"
    "fetch.prune=true"
    "diff.colorMoved=zebra"
    "merge.conflictstyle=diff3"
    "rerere.enabled=true"
    "core.autocrlf=input"
)

# =============================================================================
# CONSTANTS
# =============================================================================

readonly VERSION="7.0.0"
SCRIPT_NAME="${BASH_SOURCE[0]##*/}"
readonly SCRIPT_NAME

readonly MIN_GIT_VERSION="2.34" # first Git with SSH commit signing
readonly MIN_SSH_VERSION="8.2"  # ssh-keygen -Y sign/verify as used by Git

readonly GIT_BASE_DIR="${HOME}/Git"
readonly SSH_DIR="${HOME}/.ssh"
readonly KEY_PREFIX="id_ed25519_aahsnr_"
readonly BACKUP_ROOT="${HOME}/.config_backups"
readonly GIT_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}/git"
readonly ACCOUNT_CONFIG_DIR="${GIT_CONFIG_HOME}/accounts"
readonly ALLOWED_SIGNERS="${GIT_CONFIG_HOME}/allowed_signers"
readonly GLOBAL_GITCONFIG="${GIT_CONFIG_GLOBAL:-${HOME}/.gitconfig}"

# Parsed from ACCOUNTS by load_accounts
declare -a NAMES=() GIT_USERS=() EMAILS=()

# Runtime state
BACKUP_DIR=""
WORK_DIR=""
CHECK_DIR=""
ALL_GOOD=true

# =============================================================================
# OUTPUT AND ERROR HANDLING
# =============================================================================

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    readonly RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m'
    readonly BLUE=$'\033[0;34m' BOLD=$'\033[1m' RESET=$'\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' BLUE='' BOLD='' RESET=''
fi

info() { printf '%s→%s %s\n' "${BLUE}" "${RESET}" "$*"; }
ok() { printf '%s✓%s %s\n' "${GREEN}" "${RESET}" "$*"; }
warn() { printf '%s⚠ Warning:%s %s\n' "${YELLOW}" "${RESET}" "$*" >&2; }
die() {
    printf '%s✗ Error:%s %s\n' "${RED}" "${RESET}" "$*" >&2
    exit 1
}
section() { printf '\n%s═══ %s ═══%s\n\n' "${BOLD}${BLUE}" "$*" "${RESET}"; }
check_ok() { printf '  %s✓%s %s\n' "${GREEN}" "${RESET}" "$*"; }
check_fail() {
    printf '  %s✗%s %s\n' "${RED}" "${RESET}" "$*"
    ALL_GOOD=false
}

cleanup() {
    if [[ -n "${CHECK_DIR}" ]]; then rm -rf -- "${CHECK_DIR}"; fi
    if [[ -n "${WORK_DIR}" ]]; then rm -rf -- "${WORK_DIR}"; fi
}

on_error() {
    printf '%s✗ Unexpected failure (exit %s) at line %s: %s%s\n' \
        "${RED}" "$1" "$2" "$3" "${RESET}" >&2
}

trap cleanup EXIT
trap 'on_error "$?" "${LINENO}" "${BASH_COMMAND}"' ERR
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# =============================================================================
# HELPERS
# =============================================================================

ssh_key_path() { printf '%s/%s%s' "${SSH_DIR}" "${KEY_PREFIX}" "$1"; }
account_config_path() { printf '%s/%s.gitconfig' "${ACCOUNT_CONFIG_DIR}" "$1"; }

# The ssh command Git uses inside an account's folder: only that account's key
# is offered (IdentitiesOnly), and it is added to a running agent on first use.
ssh_command_for() {
    printf 'ssh -i %q -o IdentitiesOnly=yes -o AddKeysToAgent=yes' "$(ssh_key_path "$1")"
}

# SHA256 fingerprint of a key file; empty if unreadable. Never fails, so it is
# safe inside $(...) under errexit.
fingerprint() {
    ssh-keygen -lf "$1" 2>/dev/null | awk 'NR == 1 { print $2 }' || true
}

# Fingerprint of the public half that is embedded in a PRIVATE key file (no
# passphrase needed). `ssh-keygen -lf <key>` silently prefers a sibling
# "<key>.pub" over the key's own data, which would make a pair check compare
# the .pub with itself. Probing through a symlink in the temp dir hides the
# sibling.
private_fingerprint() {
    local probe="${WORK_DIR}/probe"
    ln -sf -- "$1" "${probe}"
    fingerprint "${probe}"
    rm -f -- "${probe}"
}

# A key pair is usable when both files exist and describe the same key.
key_pair_ok() {
    local key="$1" priv_fp pub_fp
    [[ -f "${key}" && -f "${key}.pub" ]] || return 1
    priv_fp="$(private_fingerprint "${key}")"
    pub_fp="$(fingerprint "${key}.pub")"
    [[ -n "${priv_fp}" && "${priv_fp}" == "${pub_fp}" ]]
}

# version_ge HAVE WANT  (both "major.minor")
version_ge() {
    local -a have want
    IFS=. read -r -a have <<<"$1"
    IFS=. read -r -a want <<<"$2"
    ((10#${have[0]} > 10#${want[0]} || (10#${have[0]} == 10#${want[0]} && 10#${have[1]} >= 10#${want[1]})))
}

# Copy a file into this run's private backup directory (created on first use),
# mirroring its absolute path so same-named files never collide.
backup_file() {
    local src="$1" dest
    [[ -e "${src}" ]] || return 0
    if [[ -z "${BACKUP_DIR}" ]]; then
        mkdir -p -- "${BACKUP_ROOT}"
        BACKUP_DIR="$(mktemp -d "${BACKUP_ROOT}/git-setup.XXXXXX")"
    fi
    dest="${BACKUP_DIR}${src}"
    mkdir -p -- "${dest%/*}"
    cp -p -- "${src}" "${dest}" || die "Could not back up ${src}"
    info "Backed up ${src} -> ${dest}"
}

# install_file SRC DEST MODE
# Replace DEST with SRC atomically. Does nothing if the content is identical;
# otherwise the old DEST is backed up first. Follows a symlinked DEST (dotfile
# managers) instead of replacing the link.
install_file() {
    local src="$1" dest="$2" mode="$3" staged
    if [[ -L "${dest}" ]]; then dest="$(readlink -f -- "${dest}")"; fi
    if [[ -f "${dest}" ]] && cmp -s -- "${src}" "${dest}"; then
        info "Unchanged: ${dest}"
        return 0
    fi
    backup_file "${dest}"
    staged="$(mktemp "${dest}.XXXXXX")"
    if cp -- "${src}" "${staged}" && chmod "${mode}" "${staged}" && mv -f -- "${staged}" "${dest}"; then
        ok "Wrote ${dest}"
    else
        rm -f -- "${staged}"
        die "Could not write ${dest}"
    fi
}

# =============================================================================
# VALIDATION
# =============================================================================

load_accounts() {
    local entry name user email extra j
    local email_re='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$'

    for entry in "${ACCOUNTS[@]}"; do
        extra=""
        IFS='|' read -r name user email extra <<<"${entry}"
        if [[ -z "${name}" || -z "${user}" || -z "${email}" || -n "${extra}" ]]; then
            die "Bad ACCOUNTS entry '${entry}' (expected: name|Git user name|e-mail)"
        fi
        [[ "${name}" =~ ^[a-z0-9_-]+$ ]] ||
            die "Account name '${name}' may only contain a-z, 0-9, '_' and '-'"
        [[ "${email}" =~ ${email_re} ]] || die "Invalid e-mail for '${name}': ${email}"
        for ((j = 0; j < ${#NAMES[@]}; j++)); do
            [[ "${NAMES[j]}" != "${name}" ]] || die "Duplicate account name '${name}'"
            [[ "${EMAILS[j],,}" != "${email,,}" ]] || die "Duplicate e-mail '${email}' (account '${name}')"
        done
        NAMES+=("${name}")
        GIT_USERS+=("${user}")
        EMAILS+=("${email}")
    done
}

check_dependencies() {
    local cmd git_ver ssh_ver
    local -a missing=()

    if [[ ${EUID} -eq 0 ]]; then die "Run this as your normal user, not root"; fi

    for cmd in git ssh ssh-keygen ssh-add awk cmp mktemp readlink; do
        command -v "${cmd}" >/dev/null 2>&1 || missing+=("${cmd}")
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required tools: ${missing[*]} (install them with your package manager; this script never installs software)"
    fi

    [[ "$(git --version)" =~ ([0-9]+\.[0-9]+) ]] || die "Could not determine the Git version"
    git_ver="${BASH_REMATCH[1]}"
    version_ge "${git_ver}" "${MIN_GIT_VERSION}" ||
        die "Git ${git_ver} is too old; ${MIN_GIT_VERSION}+ is needed for SSH commit signing"

    [[ "$(ssh -V 2>&1)" =~ OpenSSH_([0-9]+\.[0-9]+) ]] || die "Could not determine the OpenSSH version"
    ssh_ver="${BASH_REMATCH[1]}"
    version_ge "${ssh_ver}" "${MIN_SSH_VERSION}" ||
        die "OpenSSH ${ssh_ver} is too old; ${MIN_SSH_VERSION}+ is needed for SSH commit signing"

    ok "git ${git_ver}, OpenSSH ${ssh_ver}"
    if command -v gh >/dev/null 2>&1; then
        ok "GitHub CLI (gh) found"
    else
        info "GitHub CLI (gh) not found (optional)"
    fi
}

# =============================================================================
# SETUP STEPS
# =============================================================================

create_directories() {
    local name
    mkdir -p -- "${SSH_DIR}" "${ACCOUNT_CONFIG_DIR}"
    chmod 700 -- "${SSH_DIR}"
    for name in "${NAMES[@]}"; do
        # Code folders should keep normal permissions despite the private umask
        (umask 022 && mkdir -p -- "${GIT_BASE_DIR}/${name}")
    done
}

generate_ssh_keys() {
    section "SSH keys (Ed25519): one per account, used for login AND signing"
    local i name key

    for i in "${!NAMES[@]}"; do
        name="${NAMES[i]}"
        key="$(ssh_key_path "${name}")"
        if [[ -e "${key}" || -L "${key}" || -e "${key}.pub" || -L "${key}.pub" ]]; then
            key_pair_ok "${key}" ||
                die "Existing key pair for '${name}' is incomplete or mismatched: ${key}(.pub). Fix or move it; this script never overwrites keys."
            info "Reusing existing key for ${name}"
        else
            info "Generating key for ${name} <${EMAILS[i]}> (enter a passphrase; empty = none, not recommended)"
            ssh-keygen -q -t ed25519 -a 100 -C "${EMAILS[i]}" -f "${key}" ||
                die "ssh-keygen failed for '${name}'"
            chmod 644 -- "${key}.pub"
            ok "Created ${key}"
        fi
    done
}

# Lets `git log --show-signature` verify your own commits locally
write_allowed_signers() {
    local i type blob staged
    staged="$(mktemp "${WORK_DIR}/allowed_signers.XXXXXX")"
    for i in "${!NAMES[@]}"; do
        read -r type blob _ <"$(ssh_key_path "${NAMES[i]}").pub" || true
        printf '%s namespaces="git" %s %s\n' "${EMAILS[i]}" "${type}" "${blob}" >>"${staged}"
    done
    install_file "${staged}" "${ALLOWED_SIGNERS}" 644
}

# Per-account file: identity, signing key, and the SSH key for network access.
# Written with `git config` so values are always quoted correctly.
write_account_config() {
    local i="$1" name key staged
    name="${NAMES[i]}"
    key="$(ssh_key_path "${name}")"
    staged="$(mktemp "${WORK_DIR}/account.XXXXXX")"

    git config --file "${staged}" user.name "${GIT_USERS[i]}"
    git config --file "${staged}" user.email "${EMAILS[i]}"
    git config --file "${staged}" user.signingkey "${key}.pub"
    git config --file "${staged}" core.sshCommand "$(ssh_command_for "${name}")"
    {
        printf '# Managed by %s - changes will be overwritten on the next run\n' "${SCRIPT_NAME}"
        cat "${staged}"
    } >"${staged}.out"
    install_file "${staged}.out" "$(account_config_path "${name}")" 644
}

configure_git() {
    section "Git configuration"
    local i name real_dir key kv cfg
    cfg="$(mktemp "${WORK_DIR}/gitconfig.XXXXXX")"

    for i in "${!NAMES[@]}"; do
        write_account_config "${i}"
    done

    # Edit a COPY of the global config, then install it atomically. Everything
    # not mentioned below is preserved exactly as it was.
    if [[ -f "${GLOBAL_GITCONFIG}" ]]; then cp -- "${GLOBAL_GITCONFIG}" "${cfg}"; fi

    git config --file "${cfg}" user.name "${GIT_USERS[0]}"
    git config --file "${cfg}" user.email "${EMAILS[0]}"
    git config --file "${cfg}" user.signingkey "$(ssh_key_path "${NAMES[0]}").pub"
    git config --file "${cfg}" gpg.format ssh
    git config --file "${cfg}" gpg.ssh.allowedSignersFile "${ALLOWED_SIGNERS}"
    git config --file "${cfg}" commit.gpgsign true
    git config --file "${cfg}" tag.gpgsign true

    for kv in "${GIT_DEFAULTS[@]}"; do
        key="${kv%%=*}"
        git config --file "${cfg}" --get "${key}" >/dev/null 2>&1 ||
            git config --file "${cfg}" "${key}" "${kv#*=}"
    done

    # Conditional includes go last so they override the defaults above. Git
    # matches gitdir patterns against physical paths, hence pwd -P.
    for i in "${!NAMES[@]}"; do
        name="${NAMES[i]}"
        real_dir="$(cd -- "${GIT_BASE_DIR}/${name}" && pwd -P)"
        key="includeIf.gitdir:${real_dir}/.path"
        git config --file "${cfg}" --unset-all "${key}" || true
        git config --file "${cfg}" --add "${key}" "$(account_config_path "${name}")"
    done

    install_file "${cfg}" "${GLOBAL_GITCONFIG}" 644
}

# Load keys into a RUNNING agent only (never starts one), so passphrases are
# asked once per login session instead of on every push and signed commit.
load_keys_into_agent() {
    section "SSH agent"
    local rc=0 loaded name key fp
    local -a to_add=()

    ssh-add -l >/dev/null 2>&1 || rc=$?
    if [[ ${rc} -eq 2 ]]; then
        warn "No running ssh-agent found, so keys were not loaded."
        info "Start one (e.g. 'systemctl --user enable --now ssh-agent' or 'eval \"\$(ssh-agent)\"'), then run the ssh-add line shown at the end."
        return 0
    fi

    loaded="$(ssh-add -l 2>/dev/null || true)"
    for name in "${NAMES[@]}"; do
        key="$(ssh_key_path "${name}")"
        fp="$(fingerprint "${key}.pub")"
        if grep -qF -- "${fp}" <<<"${loaded}"; then
            info "Already loaded: ${name}"
        else
            to_add+=("${key}")
        fi
    done

    for key in "${to_add[@]}"; do
        if ssh-add "${key}"; then
            ok "Loaded ${key}"
        else
            warn "Could not load ${key}; add it later with: ssh-add ${key}"
        fi
    done
}

configure_gh() {
    command -v gh >/dev/null 2>&1 || return 0
    if gh config set git_protocol ssh 2>/dev/null; then
        ok "GitHub CLI will use SSH for Git operations"
    fi
}

# =============================================================================
# VERIFICATION
# =============================================================================

verify_setup() {
    section "Verifying"
    local i name key blob got_email got_key got_cmd

    if [[ "$(git config --file "${GLOBAL_GITCONFIG}" --get gpg.format || true)" == "ssh" ]]; then
        check_ok "Git signs with SSH keys (gpg.format = ssh)"
    else
        check_fail "gpg.format is not 'ssh' in ${GLOBAL_GITCONFIG}"
    fi

    for i in "${!NAMES[@]}"; do
        name="${NAMES[i]}"
        key="$(ssh_key_path "${name}")"

        if key_pair_ok "${key}"; then
            check_ok "${name}: SSH key pair is valid"
        else
            check_fail "${name}: SSH key pair is missing or mismatched"
            continue
        fi

        read -r _ blob _ <"${key}.pub" || true
        if grep -qF -- "${blob}" "${ALLOWED_SIGNERS}" 2>/dev/null; then
            check_ok "${name}: key is in allowed_signers"
        else
            check_fail "${name}: key is missing from ${ALLOWED_SIGNERS}"
        fi

        # Ask Git itself, from inside a throw-away repo in the account folder,
        # which settings really apply there (this exercises includeIf).
        CHECK_DIR="$(mktemp -d "${GIT_BASE_DIR}/${name}/.git-setup-check.XXXXXX")"
        git init -q "${CHECK_DIR}"
        got_email="$(git -C "${CHECK_DIR}" config --get user.email || true)"
        got_key="$(git -C "${CHECK_DIR}" config --get user.signingkey || true)"
        got_cmd="$(git -C "${CHECK_DIR}" config --get core.sshCommand || true)"
        rm -rf -- "${CHECK_DIR}"
        CHECK_DIR=""

        if [[ "${got_email}" == "${EMAILS[i]}" &&
            "${got_key}" == "${key}.pub" &&
            "${got_cmd}" == "$(ssh_command_for "${name}")" ]]; then
            check_ok "${name}: repos in ${GIT_BASE_DIR}/${name} use ${EMAILS[i]} and their own key"
        else
            check_fail "${name}: Git does not apply the expected settings in ${GIT_BASE_DIR}/${name}"
        fi
    done

    [[ "${ALL_GOOD}" == true ]]
}

# =============================================================================
# OUTPUT FOR THE USER
# =============================================================================

show_public_keys() {
    section "Public keys - add each one to its GitHub account"
    local i name key
    for i in "${!NAMES[@]}"; do
        name="${NAMES[i]}"
        key="$(ssh_key_path "${name}").pub"
        printf '%s%s%s  %s <%s>  (%s/%s)\n' \
            "${BOLD}" "${name}" "${RESET}" "${GIT_USERS[i]}" "${EMAILS[i]}" "${GIT_BASE_DIR}" "${name}"
        cat -- "${key}"
        printf 'Fingerprint: %s\n\n' "$(fingerprint "${key}")"
    done
}

show_next_steps() {
    section "Next steps"
    local name
    local -a private_keys=()
    for name in "${NAMES[@]}"; do private_keys+=("$(ssh_key_path "${name}")"); done

    cat <<EOF
${BOLD}1. Add every public key above to its GitHub account - TWICE${RESET}
   https://github.com/settings/keys  ->  New SSH key
     a) Key type "Authentication Key"   (push, pull, clone)
     b) Key type "Signing Key"          (the green "Verified" badge)
   Paste the same public key both times. Each account's commit e-mail must
   also be a verified e-mail on that GitHub account.

${BOLD}2. Test each account${RESET}
EOF
    for name in "${NAMES[@]}"; do
        printf '   ssh -i %s -o IdentitiesOnly=yes -T git@github.com   # %s\n' \
            "$(ssh_key_path "${name}")" "${name}"
    done
    cat <<EOF
   Expected: "Hi <username>! You've successfully authenticated ..."

${BOLD}3. Work as usual${RESET}
   Clone with plain URLs inside the matching folder; identity, signing key and
   SSH key are chosen automatically:
     cd ${GIT_BASE_DIR}/work && git clone git@github.com:OWNER/REPO.git

${BOLD}4. Check signing${RESET}
     git log --show-signature -1        # expect: Good "git" signature for ...

${BOLD}5. Load your keys once per login${RESET} (so passphrases are not asked repeatedly)
     ssh-add ${private_keys[*]}

${BOLD}6. Old GPG keys${RESET}
   This script does not touch GPG. Once your SSH-signed commits show "Verified",
   you can remove old GPG keys from GitHub (and from your keyring if you like).
EOF
    if [[ -n "${BACKUP_DIR}" ]]; then
        printf '\nReplaced files were backed up to: %s\n' "${BACKUP_DIR}"
    fi
    printf '\n'
    ok "Setup complete"
}

# =============================================================================
# ENTRY POINT
# =============================================================================

usage() {
    cat <<EOF
Usage: ${SCRIPT_NAME} [-h|--help] [-V|--version]

Sets up one SSH key per GitHub account (used for both login and commit
signing) and configures Git to choose the right identity, signing key and SSH
key from the folder a repository lives in (~/Git/<account>/).

Safe to re-run. Nothing is deleted; any file that changes is backed up first.
Run it from an interactive terminal as a normal (non-root) user so ssh-keygen
can ask for passphrases.
EOF
}

main() {
    case "${1:-}" in
    -h | --help)
        usage
        return 0
        ;;
    -V | --version)
        echo "${SCRIPT_NAME} ${VERSION}"
        return 0
        ;;
    "") ;;
    *)
        printf 'Unknown argument: %s\n\n' "$1" >&2
        usage >&2
        return 2
        ;;
    esac

    section "git-setup v${VERSION}"
    load_accounts
    check_dependencies
    WORK_DIR="$(mktemp -d)"

    create_directories
    generate_ssh_keys
    write_allowed_signers
    configure_git
    load_keys_into_agent
    configure_gh

    if ! verify_setup; then
        die "Verification failed; see the checks above"
    fi
    show_public_keys
    show_next_steps
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
