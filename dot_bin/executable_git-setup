# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

print_error() { printf '%b\n' "${RED}✗ Error: $*${NC}" >&2; }
print_success() { printf '%b\n' "${GREEN}✓ $*${NC}"; }
print_warning() { printf '%b\n' "${YELLOW}⚠ Warning: $*${NC}"; }
print_info() { printf '%b\n' "${BLUE}→ $*${NC}"; }
print_section() {
    echo ""
    printf '%b\n' "${BOLD}${BLUE}═══ $* ═══${NC}"
    echo ""
}

print_header() {
    local width=68 bar
    printf -v bar '%*s' "${width}" ''
    bar="${bar// /═}"
    printf '%b\n' "${BOLD}${CYAN}"
    printf '╔%s╗\n' "${bar}"
    printf '║%-*s║\n' "${width}" "   Multi-Account GitHub Setup Script v${SCRIPT_VERSION}"
    printf '║%-*s║\n' "${width}" "   SSH (Ed25519) + GPG Commit Signing + GitHub CLI"
    printf '╚%s╝\n' "${bar}"
    printf '%b' "${NC}"
}

# Like printf '%b' but takes a single string (so text is never a format string)
say() { printf '%b' "$1"; }

confirm() {
    local prompt="$1"
    local response
    while true; do
        if ! read -r -p "$(printf '%b' "${YELLOW}${prompt} [y/N]: ${NC}")" response; then
            echo ""
            return 1 # EOF on stdin counts as "no"
        fi
        case "${response}" in
        [Yy] | [Yy][Ee][Ss]) return 0 ;;
        [Nn] | [Nn][Oo] | "") return 1 ;;
        *) echo "Please answer yes or no." ;;
        esac
    done
}

command_exists() { command -v "$1" &>/dev/null; }

# True if version $1 >= version $2
version_ge() {
    printf '%s\n%s\n' "${2}" "${1}" | sort -V -C 2>/dev/null
}

ssh_key_file() { echo "${SSH_DIR}/${SSH_KEY_PREFIX}$1"; }

# Fail early when the account maps drift apart (e.g. an account added to
# ACCOUNTS but not GIT_NAMES), instead of aborting mid-run under set -u
validate_account_config() {
    local account email dir
    local seen_emails="" seen_dirs=""

    for account in "${ACCOUNT_ORDER[@]}"; do
        if [[ -z "${ACCOUNTS[${account}]:-}" ]]; then
            print_error "Account '${account}' is missing from ACCOUNTS"
            return 1
        fi
        if [[ -z "${GIT_NAMES[${account}]:-}" ]]; then
            print_error "Account '${account}' is missing from GIT_NAMES"
            return 1
        fi
    done

    for account in "${DIR_ACCOUNTS[@]}"; do
        if [[ " ${ACCOUNT_ORDER[*]} " != *" ${account} "* ]]; then
            print_error "Directory account '${account}' is not in ACCOUNT_ORDER"
            return 1
        fi
        if [[ -z "${GIT_DIRS[${account}]:-}" ]]; then
            print_error "Directory account '${account}' is missing from GIT_DIRS"
            return 1
        fi
        dir="${GIT_DIRS[${account}]}"
        if [[ " ${seen_dirs} " == *" ${dir} "* ]]; then
            print_error "Duplicate Git directory '${dir}' (account '${account}')"
            return 1
        fi
        seen_dirs+=" ${dir}"
    done

    for account in "${ACCOUNT_ORDER[@]}"; do
        email="${ACCOUNTS[${account}]}"
        if [[ " ${seen_emails} " == *" ${email} "* ]]; then
            print_error "Duplicate e-mail '${email}' (account '${account}')"
            return 1
        fi
        seen_emails+=" ${email}"
    done

    return 0
}

# Create the backup directory, private to the current user (it will hold
# private keys and tokens)
ensure_backup_dir() {
    if [[ ! -d "${BACKUP_DIR}" ]]; then
        (
            umask 077
            mkdir -p "${BACKUP_DIR}"
        )
    fi
    chmod 700 "${BACKUP_DIR}"
}

# Back up a file or directory into BACKUP_DIR, preserving its path relative to
# $HOME so that files with the same name (e.g. several .gitconfig files) never
# overwrite each other.
backup_item() {
    local item="$1"
    if [[ ! -e "${item}" && ! -L "${item}" ]]; then
        return 0
    fi

    ensure_backup_dir

    local rel dest
    if [[ "${item}" == "${HOME}/"* ]]; then
        rel="${item#"${HOME}"/}"
    else
        rel="_absolute${item}"
    fi
    dest="${BACKUP_DIR}/${rel}"

    mkdir -p "$(dirname "${dest}")"
    if cp -a "${item}" "${dest}"; then
        print_success "Backed up ${item} → ${dest}"
        return 0
    fi
    print_error "Failed to back up ${item}"
    return 1
}

# Back up a path and then delete it. If the backup fails, the path is kept.
remove_with_backup() {
    local path="$1"
    if [[ ! -e "${path}" && ! -L "${path}" ]]; then
        return 0
    fi
    if backup_item "${path}"; then
        rm -rf -- "${path}"
        print_success "Removed: ${path}"
        ITEMS_REMOVED=$((ITEMS_REMOVED + 1))
    else
        print_warning "Backup failed - leaving ${path} in place"
    fi
    return 0
}

# =============================================================================
# ERROR HANDLING AND CLEANUP
# =============================================================================

cleanup() {
    local exit_code=$?
    local item
    for item in "${TEMP_FILES[@]}"; do
        rm -f -- "${item}" 2>/dev/null || true
    done
    for item in "${TEMP_DIRS[@]}"; do
        rm -rf -- "${item}" 2>/dev/null || true
    done
    if [[ ${exit_code} -ne 0 ]]; then
        print_error "Script exited with error code ${exit_code}"
    fi
    exit "${exit_code}"
}

error_handler() {
    local line_number="$1"
    local exit_code="$2"
    print_error "Error on line ${line_number}: command failed with exit code ${exit_code}"
}

on_signal() {
    echo ""
    print_warning "Interrupted by signal"
    exit "$1"
}

trap cleanup EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'error_handler ${LINENO} $?' ERR

# =============================================================================
# DISTRO-SPECIFIC PACKAGE INSTALLATION
# =============================================================================

# Prints "<arch package> <gentoo package>" for a missing command
pkg_for_cmd() {
    case "$1" in
    git) echo "git dev-vcs/git" ;;
    ssh | ssh-keygen) echo "openssh net-misc/openssh" ;;
    gpg | gpgconf) echo "gnupg app-crypt/gnupg" ;;
    *) echo "" ;;
    esac
}

install_packages() {
    local -a sudo_cmd=()
    if [[ ${EUID} -ne 0 ]]; then
        if command_exists sudo; then
            sudo_cmd=(sudo)
        else
            print_error "Not root and 'sudo' is unavailable; cannot install packages"
            return 1
        fi
    fi

    case "${DISTRO}" in
    arch)
        print_info "Installing via pacman: $*"
        "${sudo_cmd[@]}" pacman -S --noconfirm --needed "$@"
        ;;
    gentoo)
        print_info "Installing via emerge: $*"
        "${sudo_cmd[@]}" emerge --ask=n --quiet-build "$@"
        ;;
    *)
        print_warning "Unknown distro '${DISTRO}'. Please install manually: $*"
        return 1
        ;;
    esac
}

# =============================================================================
# COMPREHENSIVE CLEANUP (full SSH, Git, GPG, and GitHub CLI reset)
# =============================================================================

# Export every secret key this user owns, then delete it from the keyring.
# A key is only deleted after its export succeeded, so a forgotten passphrase
# leaves that key in place instead of losing it. Public keys without a secret
# half (e.g. imported for signature verification) are never touched.
backup_and_remove_gpg_keys() {
    print_info "Backing up and removing GPG keys..."

    # pinentry needs the controlling terminal for export passphrase prompts
    if tty -s 2>/dev/null; then
        GPG_TTY="$(tty)"
        export GPG_TTY
    fi

    local -a fingerprints=()
    local fpr
    while IFS= read -r fpr; do
        if [[ -n "${fpr}" ]]; then
            fingerprints+=("${fpr}")
        fi
    done < <(
        gpg --list-secret-keys --with-colons --fingerprint 2>/dev/null |
            awk -F: '$1 == "sec" { have_primary = 0; next }
                    $1 == "fpr" && !have_primary { print $10; have_primary = 1 }' || true
    )

    if [[ ${#fingerprints[@]} -eq 0 ]]; then
        print_info "No GPG secret keys found"
        return 0
    fi

    local gpg_backup="${BACKUP_DIR}/gpg"
    mkdir -p "${gpg_backup}"
    chmod 700 "${gpg_backup}"

    local removed_keys=0 kept_keys=0 dest
    for fpr in "${fingerprints[@]}"; do
        dest="${gpg_backup}/secret-key-${fpr}.asc"
        if (
            umask 077
            gpg --yes --armor --output "${dest}" --export-secret-keys "${fpr}"
        ); then
            # --delete-secret-and-public-keys exits 0 even when it deletes
            # nothing, so confirm removal by listing the key again
            gpg --batch --yes --delete-secret-and-public-keys "${fpr}" 2>/dev/null || true
            if gpg --list-secret-keys --with-colons "${fpr}" &>/dev/null ||
                gpg --list-keys --with-colons "${fpr}" &>/dev/null; then
                print_warning "Backed up ${fpr} but it is still in the keyring"
                kept_keys=$((kept_keys + 1))
            else
                print_success "Backed up and removed GPG key ${fpr}"
                removed_keys=$((removed_keys + 1))
            fi
        else
            print_warning "Could not export ${fpr}; leaving the key in place (is its passphrase known?)"
            kept_keys=$((kept_keys + 1))
        fi
    done

    # Ownertrust so a restored keyring keeps its trust settings
    if (
        umask 077
        gpg --export-ownertrust >"${gpg_backup}/ownertrust.txt"
    ) 2>/dev/null; then
        chmod 600 "${gpg_backup}/ownertrust.txt"
        print_success "Owner trust backed up: ${gpg_backup}/ownertrust.txt"
    fi

    ITEMS_REMOVED=$((ITEMS_REMOVED + removed_keys))
    if [[ ${kept_keys} -gt 0 ]]; then
        print_warning "${kept_keys} GPG key(s) could not be removed (see above)"
    fi
    return 0
}

cleanup_all_configs() {
    print_section "Configuration Cleanup"

    print_warning "${BOLD}This will DELETE the following configurations:${NC}"
    echo ""
    echo "  1. SSH keys managed by this script (${SSH_DIR}/${SSH_KEY_PREFIX}<account>[.pub])"
    echo "  2. All other files in ${SSH_DIR} (other keys, known_hosts, config)"
    echo "       (the ${SSH_DIR}/agent socket directory is left in place)"
    echo "  3. Global Git config:            ${GIT_CONFIG}"
    echo "  4. XDG Git config directory:     ${GIT_XDG_CONFIG} (whole directory)"
    echo "  5. Directory Git configs:        <dir>/.gitconfig for each of:"
    local account
    for account in "${DIR_ACCOUNTS[@]}"; do
        echo "       ${GIT_DIRS[${account}]}"
    done
    echo "  6. GitHub CLI config:            ${GH_CONFIG_DIR} (removes ALL gh logins)"
    echo "  7. GPG keys:                     every secret key you own"
    echo ""
    echo -e "${CYAN}Everything is backed up first to: ${BACKUP_DIR}${NC}"
    echo -e "${YELLOW}GPG keys are exported key by key; a key whose passphrase cannot be entered is kept.${NC}"
    echo ""

    if ! confirm "Do you want to proceed with the cleanup?"; then
        print_info "Cleanup cancelled. Exiting."
        exit 0
    fi

    echo ""
    ensure_backup_dir
    print_success "Backup directory created: ${BACKUP_DIR}"
    echo ""

    ITEMS_REMOVED=0

    # 1. Managed SSH keys (exact names only)
    print_info "Removing managed SSH keys..."
    local key_file
    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"
        remove_with_backup "${key_file}"
        remove_with_backup "${key_file}.pub"
    done

    # 2. Everything else in ~/.ssh (other keys, known_hosts, config). The
    #    agent socket directory is kept so a running agent is not stranded
    if [[ -d "${SSH_DIR}" ]]; then
        print_info "Removing remaining files in ${SSH_DIR}..."
        local entry
        for entry in "${SSH_DIR}"/* "${SSH_DIR}"/.[!.]*; do
            [[ -e "${entry}" || -L "${entry}" ]] || continue
            if [[ "${entry}" == "${SSH_DIR}/agent" ]]; then
                print_info "Keeping SSH agent directory: ${entry}"
                continue
            fi
            remove_with_backup "${entry}"
        done
    fi

    # Identities from the deleted key files must not linger in a live agent
    if ssh-add -D &>/dev/null; then
        print_success "Cleared keys held by the running SSH agent"
    fi

    # 3. Global gitconfig
    remove_with_backup "${GIT_CONFIG}"

    # 4. XDG Git config directory (config, ignore, attributes, ...)
    remove_with_backup "${GIT_XDG_CONFIG}"

    # 5. Directory-specific gitconfigs (managed directories only)
    for account in "${DIR_ACCOUNTS[@]}"; do
        remove_with_backup "${GIT_DIRS[${account}]}/.gitconfig"
    done

    # 6. GitHub CLI config
    remove_with_backup "${GH_CONFIG_DIR}"

    # 7. GPG keys (exported to the backup before deletion)
    backup_and_remove_gpg_keys

    echo ""
    if [[ ${ITEMS_REMOVED} -gt 0 ]]; then
        print_success "Cleanup complete! ${ITEMS_REMOVED} item(s) removed."
    else
        print_info "No existing configurations found to remove."
    fi
    print_info "Backups saved to: ${BACKUP_DIR}"
    print_warning "The backup contains private keys and tokens - delete it once you no longer need it."

    echo ""
    print_info "Starting fresh configuration setup..."
}

# =============================================================================
# DEPENDENCY CHECKING
# =============================================================================

check_dependencies() {
    print_section "Checking Dependencies"

    print_info "Detected OS:     ${OS_TYPE}"
    print_info "Detected distro: ${DISTRO}"
    echo ""

    local -a required=(git ssh-keygen ssh gpg gpgconf)
    local -a missing=()
    local cmd

    for cmd in "${required[@]}"; do
        if command_exists "${cmd}"; then
            print_success "${cmd} found"
        else
            print_error "${cmd} not found"
            missing+=("${cmd}")
        fi
    done

    # Offer to install what is missing
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo ""
        if [[ "${DISTRO}" != "unknown" ]]; then
            local -A wanted=()
            local arch_pkg gentoo_pkg
            for cmd in "${missing[@]}"; do
                read -r arch_pkg gentoo_pkg <<<"$(pkg_for_cmd "${cmd}")"
                if [[ "${DISTRO}" == "arch" && -n "${arch_pkg:-}" ]]; then
                    wanted["${arch_pkg}"]=1
                elif [[ "${DISTRO}" == "gentoo" && -n "${gentoo_pkg:-}" ]]; then
                    wanted["${gentoo_pkg}"]=1
                fi
            done
            if [[ ${#wanted[@]} -gt 0 ]] && confirm "Install missing packages (${!wanted[*]})?"; then
                install_packages "${!wanted[@]}" || print_warning "Package installation failed"
            fi
        fi

        local -a still_missing=()
        for cmd in "${missing[@]}"; do
            command_exists "${cmd}" || still_missing+=("${cmd}")
        done
        if [[ ${#still_missing[@]} -gt 0 ]]; then
            print_error "Missing required dependencies: ${still_missing[*]}"
            print_info "Please install them and try again."
            exit 1
        fi
    fi

    # Check Git version
    local git_version
    git_version="$(git --version | sed -n 's/[^0-9]*\([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)"
    if [[ -z "${git_version}" ]]; then
        print_error "Could not determine the Git version"
        exit 1
    fi
    if version_ge "${git_version}" "${MIN_GIT_VERSION}"; then
        print_success "Git version ${git_version} (>= ${MIN_GIT_VERSION} required)"
    else
        print_error "Git version ${git_version} is too old (>= ${MIN_GIT_VERSION} required)"
        exit 1
    fi

    # Check GitHub CLI (optional)
    if command_exists gh; then
        local gh_version
        gh_version="$(gh --version 2>/dev/null | head -n 1 | sed -n 's/.*\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' || true)"
        print_success "GitHub CLI (gh) found: version ${gh_version:-unknown}"
    else
        print_warning "GitHub CLI (gh) not found (optional but recommended)"
        print_info "Install from: https://cli.github.com/"
    fi

    # GPG export (cleanup) and key generation both need a pinentry program.
    # Check it before the cleanup step so a doomed run never deletes keys.
    if pinentry_program &>/dev/null; then
        print_success "pinentry found (needed for GPG passphrase prompts)"
    else
        print_error "No pinentry program found; GPG passphrases cannot be prompted for"
        print_info "Install pinentry (Arch: 'pinentry', Gentoo: 'app-crypt/pinentry') and re-run."
        exit 1
    fi

    print_success "All required dependencies satisfied"
}

# =============================================================================
# SSH KEY MANAGEMENT
# =============================================================================

generate_ssh_keys() {
    print_section "Generating SSH Keys (Ed25519)"

    mkdir -p "${SSH_DIR}"
    chmod 700 "${SSH_DIR}"

    print_info "Using Ed25519 algorithm (modern, secure, fast)"
    echo ""

    local account key_file
    local -a pending=()
    local repaired=0
    for account in "${ACCOUNT_ORDER[@]}"; do
        key_file="$(ssh_key_file "${account}")"
        if [[ -f "${key_file}" && -f "${key_file}.pub" ]]; then
            print_info "Key for ${account} already exists: ${key_file}"
        elif [[ -f "${key_file}" ]]; then
            # A private key without its public half (e.g. after an interrupted
            # run) would otherwise be skipped and never repaired
            print_info "Public key missing for ${account}; rebuilding ${key_file}.pub"
            if ssh-keygen -y -f "${key_file}" >"${key_file}.pub" 2>/dev/null; then
                chmod 644 "${key_file}.pub"
                print_success "Rebuilt public key for ${account}"
                repaired=$((repaired + 1))
            else
                print_error "Could not rebuild public key for ${account}; remove ${key_file} and re-run"
                return 1
            fi
        else
            pending+=("${account}")
        fi
    done

    if [[ ${repaired} -gt 0 ]]; then
        print_success "Rebuilt ${repaired} public key(s)"
    fi

    if [[ ${#pending[@]} -eq 0 ]]; then
        print_info "All SSH keys already exist"
        return 0
    fi

    # Default keeps the historical behaviour (no passphrase); answering "y"
    # lets ssh-keygen prompt for a passphrase for each new key.
    local -a passphrase_args=(-N "")
    if confirm "Protect the new SSH keys with a passphrase? (recommended)"; then
        passphrase_args=()
        print_info "ssh-keygen will prompt for a passphrase for each key."
    else
        print_warning "SSH private keys will be stored unencrypted."
    fi
    echo ""

    local email generated=0
    for account in "${pending[@]}"; do
        email="${ACCOUNTS[${account}]}"
        key_file="$(ssh_key_file "${account}")"

        print_info "Generating Ed25519 key for ${account} (${email})..."

        if ssh-keygen -t ed25519 -a 100 -C "${email}" -f "${key_file}" "${passphrase_args[@]}" -q; then
            chmod 600 "${key_file}"
            chmod 644 "${key_file}.pub"

            # Use the .pub file so this never triggers a passphrase prompt
            if ssh-keygen -lf "${key_file}.pub" &>/dev/null; then
                print_success "Generated key for ${account}"
                generated=$((generated + 1))
            else
                print_error "Key generation appeared to succeed but verification failed"
                return 1
            fi
        else
            print_error "Failed to generate key for ${account}"
            return 1
        fi
    done

    print_success "Generated ${generated} new SSH key(s)"
}

